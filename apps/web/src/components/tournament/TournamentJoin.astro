---
/**
 * CTA de autoinscripción en deportes individuales (tenis, etc.).
 * Foto y color se editan en /settings, no aquí.
 */
interface Props {
  loginHref?: string;
  teamHref?: string;
  error?: string | null;
  notice?: string | null;
}

const { loginHref, teamHref, error, notice } = Astro.props;
---

<div class="t-join">
  {notice && (
    <p class="t-join__notice" role="status">{notice}</p>
  )}
  {error && (
    <p class="t-join__error" role="alert">{error}</p>
  )}
  {teamHref ? (
    <a href={teamHref} class="t-join__link">Ya estás inscrito · Ver mi ficha</a>
  ) : loginHref ? (
    <a href={loginHref} class="btn-accent t-join__btn">Inscríbete a este torneo</a>
  ) : (
    <form method="POST" class="t-join__form">
      <input type="hidden" name="intent" value="enroll" />
      <button type="submit" class="btn-accent t-join__btn">Inscríbete a este torneo</button>
    </form>
  )}
</div>

<style>
.t-join {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
}
.t-join__form {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
}
.t-join__btn {
  padding: 10px 18px;
  font-size: 0.88rem;
}
.t-join__link {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--accent);
}
.t-join__link:hover { text-decoration: underline; }
.t-join__notice {
  font-size: 0.82rem;
  color: #86efac;
}
.t-join__error {
  font-size: 0.82rem;
  color: #fca5a5;
}
</style>
