---
/**
 * TournamentRow.astro — fila completa de un torneo.
 *
 * Estructura:
 *   [header: icono deporte + nombre + stage + "Ver torneo →"]
 *   [scroll horizontal de MatchCards]
 *
 * El `data-sport` en el wrapper lo usa el filtro de tabs en el cliente
 * para mostrar/ocultar filas sin re-render del servidor.
 */
import SportIcon from '../ui/SportIcon.astro';
import MatchCard from '../match/MatchCard.astro';
import { isIndividualSport } from '@parches/config';
import type { TournamentWithMatches } from '../../data/mock';

interface Props {
  tournament: TournamentWithMatches;
}

const { tournament } = Astro.props;
const { slug, name, sport, stage, matches, teamCount } = tournament;

const liveCount = matches.filter(m => m.status === 'LIVE').length;

const sportBgClass: Record<string, string> = {
  football:   'sport-icon--football',
  basketball: 'sport-icon--basketball',
  tennis:     'sport-icon--tennis',
  volleyball: 'sport-icon--volleyball',
  baseball:   'sport-icon--baseball',
  hockey:     'sport-icon--hockey',
};

const metaParts = [
  sport.charAt(0).toUpperCase() + sport.slice(1),
  stage,
  liveCount > 0 ? `${liveCount} partido${liveCount > 1 ? 's' : ''} en vivo` : null,
  !liveCount && teamCount
    ? `${teamCount} ${isIndividualSport(sport)
      ? (teamCount === 1 ? 'jugador' : 'jugadores')
      : 'equipos'}`
    : null,
].filter(Boolean).join(' · ');
---

<section class="t-row" data-sport={sport} aria-label={`Torneo: ${name}`}>

  <!-- Row header -->
  <div class="t-row__header">
    <div class="t-row__left">
      <div class:list={['sport-icon', sportBgClass[sport]]}>
        <SportIcon sport={sport} size={16} />
      </div>
      <div class="t-row__info">
        <a href={`/tournaments/${slug}`} class="t-row__name-link" aria-label={`Ver torneo ${name}`}>
          <h2 class="t-row__name">{name}</h2>
        </a>
        <p class="t-row__meta">{metaParts}</p>
      </div>
    </div>

    <a href={`/tournaments/${slug}`} class="t-row__more" aria-label={`Ver torneo ${name}`}>
      Ver torneo
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </a>
  </div>

  <!-- Match cards horizontal strip -->
  <div class="t-row__scroller">
    <div class="t-row__fade t-row__fade--prev" hidden aria-hidden="true"></div>
    <button type="button" class="t-row__nav t-row__nav--prev" hidden aria-label="Partidos anteriores">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="t-row__strip" role="list" aria-label={`Partidos de ${name}`}>
      {matches.map(match => (
        <div role="listitem">
          <MatchCard match={match} sport={sport} />
        </div>
      ))}
    </div>
    <div class="t-row__fade t-row__fade--next" hidden aria-hidden="true"></div>
    <button type="button" class="t-row__nav t-row__nav--next" hidden aria-label="Más partidos">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
  </div>

</section>

<style>
.t-row {
  margin-bottom: 32px;
}

/* ── Header ─────────────────────────────────────────────── */
.t-row__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  margin-bottom: 12px;
}
.t-row__left {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Sport icon pill */
.sport-icon {
  width: 34px;
  height: 34px;
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.sport-icon--football   { background: linear-gradient(135deg, #0a1e12, #1a4d2e); }
.sport-icon--basketball { background: linear-gradient(135deg, #1e120a, #4d2e0a); }
.sport-icon--tennis     { background: linear-gradient(135deg, #141e08, #2e4d0a); }
.sport-icon--volleyball { background: linear-gradient(135deg, #08122b, #0a2e4d); }
.sport-icon--baseball   { background: linear-gradient(135deg, #1e0a12, #4d0a2e); }
.sport-icon--hockey     { background: linear-gradient(135deg, #0e0a1e, #1a0a4d); }

.t-row__info {}
.t-row__name {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: var(--text-primary);
  line-height: 1;
}
.t-row__meta {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
  margin-top: 3px;
}

.t-row__more {
  display: flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
  text-decoration: none;
  transition: color var(--transition);
  flex-shrink: 0;
}
.t-row__more:hover { color: var(--text-primary); }

/* ── Match strip ────────────────────────────────────────── */
.t-row__scroller {
  position: relative;
}
.t-row__strip {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 2px 24px 8px;
  scroll-behavior: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}
.t-row__strip::-webkit-scrollbar {
  height: 2px;
}
.t-row__strip::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 2px;
}
.t-row__fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 96px;
  pointer-events: none;
  z-index: 3;
}
.t-row__fade--prev {
  left: 0;
  background: linear-gradient(to right, var(--bg-base) 8%, transparent);
}
.t-row__fade--next {
  right: 0;
  background: linear-gradient(to left, var(--bg-base) 8%, transparent);
}
.t-row__fade[hidden] { display: none; }
.t-row__nav {
  position: absolute;
  top: 102px;
  z-index: 4;
  width: 36px;
  height: 36px;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
  cursor: pointer;
  transition: background 0.15s, opacity 0.15s;
}
.t-row__nav:hover { background: rgba(0, 0, 0, 0.8); }
.t-row__nav--prev { left: 30px; }
.t-row__nav--next { right: 30px; }
.t-row__nav[hidden] { display: none; }
@media (max-width: 640px) {
  .t-row__header { padding: 0 16px; }
  .t-row__nav,
  .t-row__fade { display: none; }
}
</style>

<script>
  function bindTournamentRows() {
    document.querySelectorAll<HTMLElement>('.t-row').forEach(row => {
      if (row.dataset.navBound === '1') return;
      const strip = row.querySelector<HTMLElement>('.t-row__strip');
      const prev = row.querySelector<HTMLButtonElement>('.t-row__nav--prev');
      const next = row.querySelector<HTMLButtonElement>('.t-row__nav--next');
      const fadePrev = row.querySelector<HTMLElement>('.t-row__fade--prev');
      const fadeNext = row.querySelector<HTMLElement>('.t-row__fade--next');
      if (!strip || !prev || !next || !fadePrev || !fadeNext) return;
      row.dataset.navBound = '1';

      const step = () => Math.max(280, Math.round(strip.clientWidth * 0.8));

      const sync = () => {
        const max = strip.scrollWidth - strip.clientWidth;
        const hasOverflow = max > 8;
        const atStart = strip.scrollLeft <= 8;
        const atEnd = strip.scrollLeft >= max - 8;
        prev.hidden = fadePrev.hidden = !hasOverflow || atStart;
        next.hidden = fadeNext.hidden = !hasOverflow || atEnd;
      };

      const go = (dir: number) => {
        const start = strip.scrollLeft;
        const max = strip.scrollWidth - strip.clientWidth;
        const target = Math.max(0, Math.min(max, start + dir * step()));
        const duration = 420;
        const t0 = performance.now();
        const ease = (t: number) => 1 - (1 - t) ** 3;
        const frame = (now: number) => {
          const p = Math.min(1, (now - t0) / duration);
          strip.scrollLeft = start + (target - start) * ease(p);
          if (p < 1) requestAnimationFrame(frame);
          else sync();
        };
        requestAnimationFrame(frame);
      };

      prev.addEventListener('click', () => go(-1));
      next.addEventListener('click', () => go(1));
      strip.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });
  }

  bindTournamentRows();
  document.addEventListener('astro:page-load', bindTournamentRows);
</script>