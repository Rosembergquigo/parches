---
/**
 * FixtureMatchRow.astro — fila compacta de partido para el fixture.
 * Full-width; linkea a /matches/[id].
 */
import type { MatchSnippet } from '../../data/mock';

interface Props {
  match: MatchSnippet;
}

const { match } = Astro.props;
const {
  id, homeTeam, awayTeam, homeScore, awayScore,
  status, clock, period, venue, scheduledAt,
} = match;

const isLive = status === 'LIVE';
const isScheduled = status === 'SCHEDULED';
const isFinished = status === 'FINISHED';

const homeWins = !isScheduled && homeScore > awayScore;
const awayWins = !isScheduled && awayScore > homeScore;

function formatScheduled(iso?: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  const now = new Date();
  const diffH = (d.getTime() - now.getTime()) / 3_600_000;
  if (diffH < 24) {
    return `Hoy · ${d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
  }
  if (diffH < 48) {
    return `Mañana · ${d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
  }
  return d.toLocaleDateString('es-CO', { day: 'numeric', month: 'short' });
}

const statusLabel = isLive ? 'En vivo' : isScheduled ? 'Programado' : 'Finalizado';
const clockLabel = isLive ? (clock ?? '') : isFinished ? 'FT' : formatScheduled(scheduledAt);
const contextLabel = [period, venue].filter(Boolean).join(' · ');
---

<a
  href={`/matches/${id}`}
  class:list={[
    'fmr',
    isLive && 'fmr--live',
    isScheduled && 'fmr--scheduled',
    isFinished && 'fmr--finished',
  ]}
  aria-label={`${homeTeam.name} vs ${awayTeam.name}`}
>
  <div class:list={['fmr__status', isLive && 'fmr__status--live']}>
    {isLive && <span class="fmr__dot" aria-hidden="true" />}
    {statusLabel}
  </div>

  <div class="fmr__teams">
    <span class:list={['fmr__team', homeWins && 'fmr__team--win']}>{homeTeam.shortName}</span>
    <div class="fmr__score">
      {isScheduled ? (
        <span class="fmr__vs">vs</span>
      ) : (
        <>
          <span class:list={[homeWins && 'fmr__score--win']}>{homeScore}</span>
          <span class="fmr__sep">—</span>
          <span class:list={[awayWins && 'fmr__score--win']}>{awayScore}</span>
        </>
      )}
    </div>
    <span class:list={['fmr__team', awayWins && 'fmr__team--win']}>{awayTeam.shortName}</span>
  </div>

  <div class="fmr__meta">
    {contextLabel && <span class="fmr__context">{contextLabel}</span>}
    <span class="fmr__clock">{clockLabel || '−'}</span>
  </div>

  <span class="fmr__arrow" aria-hidden="true">→</span>
</a>

<style>
.fmr {
  display: grid;
  grid-template-columns: 108px minmax(160px, 1fr) auto 20px;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  min-height: 56px;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  text-decoration: none;
  position: relative;
  transition: border-color var(--transition), transform var(--transition);
}
.fmr:hover {
  border-color: var(--border-hover);
  transform: translateY(-1px);
}
.fmr--live {
  border-color: rgba(255,59,59,0.3);
}
.fmr--live::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 2px;
  background: var(--live);
  border-radius: 2px 0 0 2px;
}
.fmr--scheduled::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 2px;
  background: var(--accent);
  border-radius: 2px 0 0 2px;
}

.fmr__status {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 5px;
}
.fmr__status--live { color: var(--live); }
.fmr__dot {
  width: 5px; height: 5px;
  background: var(--live);
  border-radius: 50%;
  flex-shrink: 0;
  animation: pulse-dot 1.2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.65)}
}

.fmr__teams {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
.fmr__team {
  font-family: var(--font-display);
  font-size: 0.88rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-primary);
  min-width: 40px;
}
.fmr__team--win { color: var(--accent); }
.fmr__score {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 5px;
  min-width: 52px;
  justify-content: center;
}
.fmr__score--win { color: var(--accent); }
.fmr__sep { color: var(--text-muted); font-weight: 600; font-size: 0.85rem; }
.fmr__vs {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.fmr__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  min-width: 0;
}
.fmr__context {
  font-family: var(--font-display);
  font-size: 0.55rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
  max-width: 180px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fmr__clock {
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
}
.fmr__arrow {
  color: var(--text-muted);
  font-size: 0.85rem;
}

@media (max-width: 640px) {
  .fmr {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    gap: 8px;
  }
  .fmr__status { grid-column: 1; }
  .fmr__arrow { grid-column: 2; grid-row: 1; }
  .fmr__teams { grid-column: 1 / -1; }
  .fmr__meta {
    grid-column: 1 / -1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
}
</style>
