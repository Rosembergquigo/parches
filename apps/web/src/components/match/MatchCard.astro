---
/**
 * MatchCard.astro — card de partido reutilizable.
 *
 * Maneja los 3 estados:
 *   LIVE      → barra roja, reloj, score con ganador resaltado, "Ver ahora →"
 *   SCHEDULED → barra cyan, hora formateada, "Programar"
 *   FINISHED  → sin barra, "FT", score opaco, "Resumen"
 *
 * Hero: escudos de ambos equipos sobre un degradado con un cambio
 * de color justo en la mitad (efecto "vs"). El degradado usa el
 * color de marca de cada equipo (team.color); si algún equipo no
 * lo define, cae al duotono genérico del deporte.
 *
 * Navega directamente a /matches/[id] — sin pasar por el torneo.
 * La prop `venue`, `period` y `sport` son opcionales.
 */
import type { MatchSnippet, Sport } from '../../data/mock';
import TeamCrest from '../team/TeamCrest.astro';

interface Props {
  match: MatchSnippet;
  sport?: Sport;
}

const { match, sport } = Astro.props;
const { homeTeam, awayTeam, homeScore, awayScore, status, clock, period, venue,
        scheduledAt, viewerCount, id } = match;

const isLive      = status === 'LIVE';
const isScheduled = status === 'SCHEDULED';
const isFinished  = status === 'FINISHED';

const homeWins = homeScore > awayScore;
const awayWins = awayScore > homeScore;

// ── Hero gradient: color de cada equipo, con el cambio justo en la mitad ──
// Fallback: duotono genérico por deporte cuando algún equipo no tiene color.
const sportDuo: Record<string, [string, string]> = {
  football:   ['#0a1e12', '#1a4d2e'],
  basketball: ['#1e120a', '#4d2e0a'],
  tennis:     ['#141e08', '#2e4d0a'],
  volleyball: ['#08122b', '#0a2e4d'],
  baseball:   ['#1e0a12', '#4d0a2e'],
  hockey:     ['#0e0a1e', '#1a0a4d'],
};
const [fallbackA, fallbackB] = sportDuo[sport ?? ''] ?? ['#15171c', '#242833'];
const colorA = homeTeam.color ?? fallbackA;
const colorB = awayTeam.color ?? fallbackB;
// Se mezcla con negro para que el color del equipo no rompa el tema oscuro
// y mantenga contraste con el texto/escudos blancos del hero.
const shadeA = `color-mix(in srgb, ${colorA} 54%, #05070a 55%)`;
const shadeB = `color-mix(in srgb, ${colorB} 54%, #05070a 55%)`;
const heroBg = `linear-gradient(110deg, ${shadeA} 0% 49%, ${shadeB} 50% 100%)`;

// Format scheduled time
function formatScheduled(iso?: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  const now = new Date();
  const diffH = (d.getTime() - now.getTime()) / 3_600_000;
  if (diffH < 24) {
    return `Hoy · ${d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
  }
  if (diffH < 48) {
    return `Mañana · ${d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
  }
  return d.toLocaleDateString('es-CO', { day: 'numeric', month: 'short' });
}

// Format viewer count
function formatViewers(n?: number): string {
  if (!n) return '';
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return String(n);
}

const scheduledLabel = isScheduled ? formatScheduled(scheduledAt) : '';
const viewersLabel   = viewerCount ? formatViewers(viewerCount) : '';
---

<a
  href={`/matches/${id}`}
  class:list={['mc', isLive && 'mc--live', isScheduled && 'mc--scheduled', isFinished && 'mc--finished']}
  aria-label={`${homeTeam.name} vs ${awayTeam.name}`}
>
  <!-- Hero: escudos + degradado por deporte con cambio en la mitad -->
  <div class="mc__hero" style={`background: ${heroBg}`}>
    <div class="mc__hero-top">
      {isLive && (
        <div class="mc__status mc__status--live">
          <span class="mc__live-dot" aria-hidden="true"></span>
          En vivo
        </div>
      )}
      {isScheduled && (
        <div class="mc__status mc__status--soon">{scheduledLabel}</div>
      )}
      {isFinished && (
        <div class="mc__status mc__status--fin">Finalizado</div>
      )}
      <div class="mc__clock">{isLive ? clock : isFinished ? 'FT' : '−'}</div>
    </div>

    <div class="mc__hero-crests">
      <div class="mc__crest">
        <TeamCrest shortName={homeTeam.shortName} logoUrl={homeTeam.logoUrl} />
      </div>
      <span class="mc__vs">VS</span>
      <div class="mc__crest">
        <TeamCrest shortName={awayTeam.shortName} logoUrl={awayTeam.logoUrl} />
      </div>
    </div>
  </div>

  <!-- Teams + scores -->
  <div class="mc__body">
    <div class="mc__team-row">
      <div class="mc__name">{homeTeam.name}</div>
      <div class:list={['mc__score', homeWins && !isScheduled && 'mc__score--win']}>
        {isScheduled ? '−' : homeScore}
      </div>
    </div>
    <div class="mc__divider"></div>
    <div class="mc__team-row">
      <div class="mc__name">{awayTeam.name}</div>
      <div class:list={['mc__score', awayWins && !isScheduled && 'mc__score--win']}>
        {isScheduled ? '−' : awayScore}
      </div>
    </div>
  </div>

  <!-- Period / venue / extra context -->
  <div class="mc__period">
    {isLive && (period || venue) && `${period}${venue ? ` · ${venue}` : ''}`}
    {isScheduled && period}
    {isFinished && 'Resultado final'}
  </div>

  <!-- Footer: viewers + CTA -->
  <div class="mc__footer">
    <div class="mc__viewers">
      {isLive && viewersLabel && `● ${viewersLabel}`}
      {isScheduled && '● Recordar'}
      {isFinished && !isScheduled && ''}
    </div>
    {isLive      && <span class="mc__btn mc__btn--now">Ver ahora →</span>}
    {isScheduled && <span class="mc__btn mc__btn--soon">Programar</span>}
    {isFinished  && <span class="mc__btn mc__btn--recap">Resumen</span>}
  </div>
</a>

<style>
/* ── Base card ──────────────────────────────────────────── */
.mc {
  flex-shrink: 0;
  width: 340px;
  background: transparent;
  border: none;
  cursor: pointer;
  text-decoration: none;
  display: block;
  position: relative;
  transition: transform 0.2s ease;
  margin-right: 10px;
}
.mc:hover {
  transform: translateY(-3px);
}

/* ── Hero: escudos + degradado con cambio en la mitad ──── */
.mc__hero {
  position: relative;
  height: 200px;
  padding: 8px 10px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 12px 12px 20px 20px;
  overflow: hidden;
  margin-bottom: 6px;
}
.mc--live .mc__hero::before,
.mc--scheduled .mc__hero::before {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  z-index: 3;
}
.mc--live .mc__hero::before { background: var(--live); }
.mc--scheduled .mc__hero::before { background: var(--accent); }

.mc__hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}
.mc__status {
  font-family: var(--font-display);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  display: flex;
  align-items: center;
  gap: 4px;
}
.mc__status--live { color: var(--live); }
.mc__status--soon { color: rgba(255, 255, 255, 0.75); }
.mc__status--fin  { color: rgba(255, 255, 255, 0.5); }

.mc__live-dot {
  width: 5px;
  height: 5px;
  background: var(--live);
  border-radius: 50%;
  flex-shrink: 0;
  animation: pulse-dot 1.2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.4; transform: scale(0.65); }
}

.mc__clock {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: rgba(255, 255, 255, 0.75);
}

.mc__hero-crests {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  min-height: 0;
}
.mc__crest {
  width: 100px;
  height: 100px;
  flex: 0 0 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  /*background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.18);*/ 
  overflow: hidden;
}
.mc__crest :global(.crest) {
  width: 100%;
  height: 100%;
}
.mc__crest :global(img) {
  max-width: 100%;
  max-height: 100%;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  padding: 8px;
  box-sizing: border-box;
}
.mc__crest :global(.crest__abbr) {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 900;
  letter-spacing: 0.02em;
  color: rgba(255, 255, 255, 0.85);
}
.mc__vs {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}

/* ── Body: teams ────────────────────────────────────────── */
.mc__body {
  padding: 8px 10px 2px;
  background: none;
}
.mc__team-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 3px;
}
.mc__team-row:last-of-type { margin-bottom: 0; }

.mc__name {
  font-family: var(--font-display);
  font-size: 0.90rem;
  font-weight: 400;
  letter-spacing: 0.03em;
  color: var(--text-primary);
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mc__score {
  font-family: var(--font-display);
  font-size: 0.88rem;
  font-weight: 900;
  color: var(--text-primary);
  min-width: 16px;
  text-align: right;
  flex-shrink: 0;
}
.mc__score--win { color: var(--accent); }

.mc__divider {
  height: 1px;
  background: transparent;
  margin: 3px 0;
}

/* ── Period ─────────────────────────────────────────────── */
.mc__period {
  font-family: var(--font-display);
  font-size: 0.52rem;
  font-weight: 600;
  letter-spacing: 0.09em;
  color: var(--text-muted);
  padding: 2px 10px 4px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  background: none;
}

/* ── Footer ─────────────────────────────────────────────── */
.mc__footer {
  padding: 4px 10px 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: none;
}
.mc__viewers {
  font-family: var(--font-display);
  font-size: 0.52rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  color: var(--text-muted);
}
.mc__btn {
  font-family: var(--font-display);
  font-size: 0.55rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  padding: 3px 8px;
  border-radius: 5px;
  flex-shrink: 0;
}
.mc__btn--now  { background: var(--accent); color: #000; }
.mc__btn--soon { background: transparent; color: var(--text-secondary); border: 1px solid var(--border); }
.mc__btn--recap{ background: var(--bg-raised); color: var(--text-secondary); border: 1px solid var(--border); }
</style>