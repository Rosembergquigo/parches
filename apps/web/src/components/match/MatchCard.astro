---
/**
 * MatchCard.astro — card de partido reutilizable.
 *
 * Maneja los 3 estados:
 *   LIVE      → barra roja, reloj, score con ganador resaltado, "Ver ahora →"
 *   SCHEDULED → barra cyan, hora formateada, "Programar"
 *   FINISHED  → sin barra, "FT", score opaco, "Resumen"
 *
 * Navega directamente a /matches/[id] — sin pasar por el torneo.
 * La prop `venue` y `period` son opcionales.
 */
import type { MatchSnippet } from '../../data/mock';

interface Props {
  match: MatchSnippet;
}

const { match } = Astro.props;
const { homeTeam, awayTeam, homeScore, awayScore, status, clock, period, venue,
        scheduledAt, viewerCount, id } = match;

const isLive      = status === 'LIVE';
const isScheduled = status === 'SCHEDULED';
const isFinished  = status === 'FINISHED';

const homeWins = homeScore > awayScore;
const awayWins = awayScore > homeScore;

// Format scheduled time
function formatScheduled(iso?: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  const now = new Date();
  const diffH = (d.getTime() - now.getTime()) / 3_600_000;
  if (diffH < 24) {
    return `Hoy · ${d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
  }
  if (diffH < 48) {
    return `Mañana · ${d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
  }
  return d.toLocaleDateString('es-CO', { day: 'numeric', month: 'short' });
}

// Format viewer count
function formatViewers(n?: number): string {
  if (!n) return '';
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return String(n);
}

const scheduledLabel = isScheduled ? formatScheduled(scheduledAt) : '';
const viewersLabel   = viewerCount ? formatViewers(viewerCount) : '';
---

<a
  href={`/matches/${id}`}
  class:list={['mc', isLive && 'mc--live', isScheduled && 'mc--scheduled', isFinished && 'mc--finished']}
  aria-label={`${homeTeam.name} vs ${awayTeam.name}`}
>
  <!-- Top bar: status + clock -->
  <div class="mc__top">
    {isLive && (
      <div class="mc__status mc__status--live">
        <span class="mc__live-dot" aria-hidden="true"></span>
        En vivo
      </div>
    )}
    {isScheduled && (
      <div class="mc__status mc__status--soon">{scheduledLabel}</div>
    )}
    {isFinished && (
      <div class="mc__status mc__status--fin">Finalizado</div>
    )}
    <div class="mc__clock">{isLive ? clock : isFinished ? 'FT' : '−'}</div>
  </div>

  <!-- Teams + scores -->
  <div class="mc__body">
    <div class="mc__team-row">
      <div class="mc__logo" aria-hidden="true">{homeTeam.shortName}</div>
      <div class="mc__name">{homeTeam.name.split(' ')[0]}</div>
      <div class:list={['mc__score', homeWins && !isScheduled && 'mc__score--win']}>
        {isScheduled ? '−' : homeScore}
      </div>
    </div>
    <div class="mc__divider"></div>
    <div class="mc__team-row">
      <div class="mc__logo" aria-hidden="true">{awayTeam.shortName}</div>
      <div class="mc__name">{awayTeam.name.split(' ')[0]}</div>
      <div class:list={['mc__score', awayWins && !isScheduled && 'mc__score--win']}>
        {isScheduled ? '−' : awayScore}
      </div>
    </div>
  </div>

  <!-- Period / venue / extra context -->
  <div class="mc__period">
    {isLive && (period || venue) && `${period}${venue ? ` · ${venue}` : ''}`}
    {isScheduled && period}
    {isFinished && 'Resultado final'}
  </div>

  <!-- Footer: viewers + CTA -->
  <div class="mc__footer">
    <div class="mc__viewers">
      {isLive && viewersLabel && `● ${viewersLabel}`}
      {isScheduled && '● Recordar'}
      {isFinished && !isScheduled && ''}
    </div>
    {isLive      && <span class="mc__btn mc__btn--now">Ver ahora →</span>}
    {isScheduled && <span class="mc__btn mc__btn--soon">Programar</span>}
    {isFinished  && <span class="mc__btn mc__btn--recap">Resumen</span>}
  </div>
</a>

<style>
/* ── Base card ──────────────────────────────────────────── */
.mc {
  flex-shrink: 0;
  width: 200px;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  cursor: pointer;
  text-decoration: none;
  display: block;
  position: relative;
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.mc:hover {
  transform: translateY(-3px);
}

/* top accent line by state */
.mc--live::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--live);
}
.mc--scheduled::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--accent);
}
.mc--live:hover    { border-color: rgba(255, 59, 59, 0.4); }
.mc--scheduled:hover { border-color: rgba(0, 229, 255, 0.4); }
.mc--finished:hover  { border-color: var(--border-hover); }

/* ── Top row ──────────────────────────────────────────── */
.mc__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px 0;
}
.mc__status {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 4px;
}
.mc__status--live { color: var(--live); }
.mc__status--soon { color: var(--text-secondary); }
.mc__status--fin  { color: var(--text-muted); }

.mc__live-dot {
  width: 5px;
  height: 5px;
  background: var(--live);
  border-radius: 50%;
  flex-shrink: 0;
  animation: pulse-dot 1.2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.4; transform: scale(0.65); }
}

.mc__clock {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
}

/* ── Body: teams ────────────────────────────────────────── */
.mc__body {
  padding: 10px 12px 6px;
}
.mc__team-row {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 5px;
}
.mc__team-row:last-of-type { margin-bottom: 0; }

.mc__logo {
  width: 22px;
  height: 22px;
  border-radius: 4px;
  background: var(--bg-raised);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 0.5rem;
  font-weight: 800;
  color: var(--text-secondary);
  flex-shrink: 0;
  letter-spacing: 0.02em;
}
.mc__name {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--text-primary);
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mc__score {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 900;
  color: var(--text-primary);
  min-width: 18px;
  text-align: right;
  flex-shrink: 0;
}
.mc__score--win { color: var(--accent); }

.mc__divider {
  height: 1px;
  background: var(--border);
  margin: 6px 0;
}

/* ── Period ─────────────────────────────────────────────── */
.mc__period {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--text-muted);
  padding: 0 12px 8px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Footer ─────────────────────────────────────────────── */
.mc__footer {
  border-top: 1px solid var(--border);
  padding: 7px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mc__viewers {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.mc__btn {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 5px;
  flex-shrink: 0;
}
.mc__btn--now  { background: var(--accent); color: #000; }
.mc__btn--soon { background: transparent; color: var(--text-secondary); border: 1px solid var(--border); }
.mc__btn--recap{ background: var(--bg-raised); color: var(--text-secondary); border: 1px solid var(--border); }
</style>