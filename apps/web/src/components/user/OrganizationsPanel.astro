---
/**
 * OrganizationsPanel.astro — "Mis empresas" en el perfil.
 *
 * Siempre visible para el usuario autenticado: organizar no depende de
 * User.role. Lista membresías y un CTA para crear otra empresa.
 */
import type { OrganizationSummary, OrgRole } from '../../data/mock';

interface Props {
  organizations: OrganizationSummary[];
}

const { organizations } = Astro.props;

const ROLE_LABEL: Record<OrgRole, string> = {
  OWNER: 'Dueño',
  ADMIN: 'Admin',
  EDITOR: 'Editor',
};

function initials(name: string): string {
  return name
    .split(' ')
    .filter(w => w.length > 2)
    .slice(0, 2)
    .map(w => w[0]!.toUpperCase())
    .join('') || name.slice(0, 2).toUpperCase();
}
---

<section class="orgs" id="empresas" aria-label="Mis empresas">
  <div class="orgs__header">
    <h2 class="orgs__title">Mis empresas</h2>
    <a href="/orgs/new" class="btn-accent" style="padding: 8px 16px; font-size: 0.78rem;">
      Crear empresa
    </a>
  </div>

  {organizations.length === 0 ? (
    <p class="orgs__empty">
      Todavía no administras ninguna empresa. Crea una para publicar torneos.
    </p>
  ) : (
    <div class="orgs__grid" role="list">
      {organizations.map(org => (
        <div class="org-card" role="listitem">
          <a href={`/orgs/${org.slug}`} class="org-card__main">
            <div
              class="org-card__mark"
              style={org.brandColor ? `background: ${org.brandColor}` : undefined}
              aria-hidden="true"
            >
              {org.logoUrl ? (
                <img src={org.logoUrl} alt="" />
              ) : (
                initials(org.name)
              )}
            </div>
            <div class="org-card__body">
              <span class="org-card__name">{org.name}</span>
              <span class="org-card__meta">
                {ROLE_LABEL[org.myRole]}
                {org.city ? ` · ${org.city}` : ''}
                {` · ${org.tournamentCount} torneo${org.tournamentCount === 1 ? '' : 's'}`}
              </span>
            </div>
          </a>
          <a href={`/orgs/${org.slug}/tournaments/new`} class="org-card__action">
            Crear torneo
          </a>
        </div>
      ))}
    </div>
  )}
</section>

<style>
.orgs { margin-top: 36px; }
.orgs__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}
.orgs__title {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-primary);
  margin: 0;
}
.orgs__empty {
  font-size: 0.88rem;
  color: var(--text-secondary);
  padding: 20px 16px;
  background: var(--bg-surface);
  border: 1px dashed var(--border);
  border-radius: var(--radius-lg);
}
.orgs__grid {
  display: flex;
  flex-direction: column;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.org-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--border);
  transition: background var(--transition);
}
.org-card:last-child { border-bottom: none; }
.org-card:hover { background: var(--bg-raised); }
.org-card__main {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
  text-decoration: none;
}
.org-card__action {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  flex-shrink: 0;
  padding: 6px 0;
}
.org-card__mark {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--bg-raised);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 0.7rem;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
}
.org-card__mark img { width: 100%; height: 100%; object-fit: cover; }
.org-card__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.org-card__name {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.org-card__meta {
  font-family: var(--font-display);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.org-card svg { color: var(--text-muted); flex-shrink: 0; }
</style>
