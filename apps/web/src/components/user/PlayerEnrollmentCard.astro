---
/**
 * PlayerEnrollmentCard.astro — tarjeta de inscripción del jugador.
 *
 * Muestra un torneo en el que el jugador está/estuvo inscrito:
 * equipo, posición, dorsal y estadísticas acumuladas del torneo.
 *
 * Las stats se renderizan según PLAYER_STAT_DEFS[sport],
 * así cada deporte muestra sus propias métricas sin lógica condicional
 * en el template.
 */
import SportIcon from '../ui/SportIcon.astro';
import type { PlayerEnrollment } from '../../data/mock';
import { PLAYER_STAT_DEFS } from '../../data/mock';

interface Props {
  enrollment: PlayerEnrollment;
}

const { enrollment } = Astro.props;
const {
  tournamentName, tournamentSlug, sport, teamName, teamShortName,
  jerseyNumber, position, isActive, matchesPlayed, tournamentStats,
} = enrollment;

const statDefs = PLAYER_STAT_DEFS[sport] ?? [];

const sportBg: Record<string, string> = {
  football:   'linear-gradient(135deg,#0a1e12,#1a4d2e)',
  basketball: 'linear-gradient(135deg,#1e120a,#4d2e0a)',
  tennis:     'linear-gradient(135deg,#141e08,#2e4d0a)',
  volleyball: 'linear-gradient(135deg,#08122b,#0a2e4d)',
  baseball:   'linear-gradient(135deg,#1e0a12,#4d0a2e)',
  hockey:     'linear-gradient(135deg,#0e0a1e,#1a0a4d)',
};

const sportLabel: Record<string, string> = {
  football: 'Fútbol', basketball: 'Baloncesto', tennis: 'Tenis',
  volleyball: 'Voleibol', baseball: 'Béisbol', hockey: 'Hockey',
};
---

<div class:list={['pec', !isActive && 'pec--inactive']}>

  <!-- Card header: sport banner + team info -->
  <div class="pec__banner" style={`background: ${sportBg[sport]}`}>
    <div class="pec__banner-overlay" aria-hidden="true"></div>

    <div class="pec__banner-content">
      <div class="pec__sport-icon">
        <SportIcon sport={sport} size={16} stroke="rgba(255,255,255,0.8)" />
      </div>
      <div class="pec__banner-info">
        <div class="pec__sport-label">{sportLabel[sport]}</div>
        <a href={`/tournaments/${tournamentSlug}`} class="pec__tournament">
          {tournamentName}
        </a>
      </div>
      {isActive ? (
        <span class="pec__active-badge">Activo</span>
      ) : (
        <span class="pec__finished-badge">Finalizado</span>
      )}
    </div>
  </div>

  <!-- Team + jersey -->
  <div class="pec__team-row">
    <div class="pec__team-logo" aria-hidden="true">{teamShortName}</div>
    <div class="pec__team-info">
      <span class="pec__team-name">{teamName}</span>
      <div class="pec__team-meta">
        {jerseyNumber && <span class="pec__jersey">#{jerseyNumber}</span>}
        {position    && <span class="pec__position">{position}</span>}
      </div>
    </div>
    <div class="pec__played">
      <span class="pec__played-num">{matchesPlayed}</span>
      <span class="pec__played-label">partidos</span>
    </div>
  </div>

  <!-- Stats grid — keys defined by sport -->
  {tournamentStats && statDefs.length > 0 && (
    <div class="pec__stats">
      {statDefs.map(def => (
        <div class="pec__stat">
          <span class="pec__stat-value">
            {tournamentStats[def.key] ?? 0}
            {def.key.endsWith('Pct') ? '%' : ''}
          </span>
          <span class="pec__stat-label">{def.shortLabel}</span>
          <span class="pec__stat-full">{def.label}</span>
        </div>
      ))}
    </div>
  )}

</div>

<style>
.pec {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: border-color var(--transition), transform var(--transition);
}
.pec:hover { border-color: var(--border-hover); transform: translateY(-2px); }
.pec--inactive { opacity: 0.65; }
.pec--inactive:hover { opacity: 0.85; }

/* Banner */
.pec__banner {
  position: relative;
  padding: 14px 16px;
  overflow: hidden;
}
.pec__banner-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to right, transparent, rgba(0,0,0,0.4));
  pointer-events: none;
}
.pec__banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 10px;
}
.pec__sport-icon {
  width: 32px; height: 32px;
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pec__banner-info { flex: 1; min-width: 0; }
.pec__sport-label {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  margin-bottom: 1px;
}
.pec__tournament {
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: #fff;
  text-decoration: none;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pec__tournament:hover { opacity: 0.8; }

.pec__active-badge {
  font-family: var(--font-display);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  padding: 2px 7px;
  border: 1px solid rgba(0,229,255,0.4);
  border-radius: 3px;
  background: rgba(0,229,255,0.12);
  flex-shrink: 0;
}
.pec__finished-badge {
  font-family: var(--font-display);
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  padding: 2px 7px;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 3px;
  flex-shrink: 0;
}

/* Team row */
.pec__team-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
}
.pec__team-logo {
  width: 36px; height: 36px;
  border-radius: 7px;
  background: var(--bg-raised);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 0.55rem;
  font-weight: 900;
  color: var(--text-secondary);
  flex-shrink: 0;
  letter-spacing: 0;
}
.pec__team-info { flex: 1; min-width: 0; }
.pec__team-name {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--text-primary);
  display: block;
  margin-bottom: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pec__team-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}
.pec__jersey {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--accent);
}
.pec__position {
  font-family: var(--font-display);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-secondary);
}
.pec__played {
  text-align: center;
  flex-shrink: 0;
}
.pec__played-num {
  display: block;
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1;
}
.pec__played-label {
  font-family: var(--font-display);
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
}

/* Stats grid */
.pec__stats {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
  padding: 12px 16px;
  gap: 4px;
}
.pec__stat {
  text-align: center;
  padding: 8px 4px;
  border-radius: var(--radius-md);
  transition: background var(--transition);
}
.pec__stat:hover { background: var(--bg-raised); }

.pec__stat-value {
  display: block;
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1;
  margin-bottom: 2px;
}
.pec__stat-label {
  display: block;
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--accent);
}
/* Full label visible on hover via title — shown below on mobile */
.pec__stat-full {
  display: none;
  font-family: var(--font-display);
  font-size: 0.55rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-top: 1px;
}
.pec__stat:hover .pec__stat-full { display: block; }
</style>
