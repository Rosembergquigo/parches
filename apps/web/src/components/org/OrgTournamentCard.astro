---
/**
 * Minicard de un torneo en la ficha de empresa.
 * Portada + datos. El destino público es Chapi; el dashboard es atajo.
 */
import { isIndividualSport } from '@parches/config';
import type { TournamentWithMatches } from '../../data/mock';
import { orgDashPath } from '../../lib/orgDash';
import { foldQuery } from '../../lib/search';

interface Props {
  tournament: TournamentWithMatches;
  orgSlug: string;
  canManage?: boolean;
}

const { tournament: t, orgSlug, canManage = false } = Astro.props;

const STATUS_LABEL: Record<string, string> = {
  LIVE: 'En vivo',
  UPCOMING: 'Próximo',
  FINISHED: 'Cerrado',
};

const SPORT_LABEL: Record<string, string> = {
  football: 'Fútbol',
  basketball: 'Baloncesto',
  tennis: 'Tenis',
  volleyball: 'Voleibol',
  baseball: 'Béisbol',
  hockey: 'Hockey',
  motor: 'Motor',
  padel: 'Pádel',
  eSports: 'eSports',
  boxeo: 'Boxeo',
};

const SPORT_FALLBACK: Record<string, string> = {
  football: 'linear-gradient(135deg, #0a1e12, #1a4d2e)',
  basketball: 'linear-gradient(135deg, #1e120a, #4d2e0a)',
  tennis: 'linear-gradient(135deg, #141e08, #2e4d0a)',
  volleyball: 'linear-gradient(135deg, #08122b, #0a2e4d)',
};

const publicHref = `/tournaments/${t.slug}`;
const dash = (op?: string) => orgDashPath(orgSlug, t.slug, op);
const individual = isIndividualSport(t.sport);
const countLabel = t.teamCount
  ? `${t.teamCount} ${individual
    ? (t.teamCount === 1 ? 'jugador' : 'jugadores')
    : (t.teamCount === 1 ? 'equipo' : 'equipos')}`
  : null;
const initials = t.name
  .split(' ')
  .filter(w => w.length > 2)
  .slice(0, 2)
  .map(w => w[0]!.toUpperCase())
  .join('') || t.name.slice(0, 2).toUpperCase();

const coverUrl = t.backgroundImageUrl;
const logoUrl = t.logoUrl;
const mediaBg = t.brandColor
  ? `linear-gradient(135deg, ${t.brandColor}66 0%, #0a0c0f 100%)`
  : (SPORT_FALLBACK[t.sport] ?? 'linear-gradient(135deg, #1c1c20, #0a0c0f)');
const dataNombre = foldQuery([t.name, t.stage].filter(Boolean).join(' '));
const dataDeporte = foldQuery([t.sport, SPORT_LABEL[t.sport]].filter(Boolean).join(' '));
---

<article class="mini" data-nombre={dataNombre} data-deporte={dataDeporte}>
  <a href={publicHref} class="mini__main">
    <div class="mini__media" style={`background: ${mediaBg}`}>
      {coverUrl ? (
        <img src={coverUrl} alt="" loading="lazy" class="mini__cover" />
      ) : logoUrl ? (
        <img src={logoUrl} alt="" loading="lazy" class="mini__media-logo" />
      ) : (
        <span class="mini__initials" aria-hidden="true">{initials}</span>
      )}
      {coverUrl && logoUrl && (
        <span class="mini__crest" aria-hidden="true">
          <img src={logoUrl} alt="" />
        </span>
      )}
      <span class:list={['mini__status', `is-${t.status.toLowerCase()}`]}>
        {STATUS_LABEL[t.status]}
      </span>
    </div>
    <div class="mini__body">
      <h3 class="mini__name">{t.name}</h3>
      <p class="mini__meta">
        {[SPORT_LABEL[t.sport] ?? t.sport, countLabel].filter(Boolean).join(' · ')}
      </p>
    </div>
  </a>

  <div class="mini__footer">
    <a href={publicHref} class="mini__go">Ver en Chapi</a>
    {canManage && (
      <nav class="mini__shortcuts" aria-label={`Administrar ${t.name}`}>
        <a href={dash()}>Ajustes</a>
        <a href={dash('foro')}>Foro</a>
        <a href={dash('operar')}>Operar</a>
        <a href={dash('equipos')}>{individual ? 'Jugadores' : 'Equipos'}</a>
      </nav>
    )}
  </div>
</article>

<style>
.mini[hidden] { display: none; }
.mini {
  display: flex;
  flex-direction: column;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  min-height: 0;
  transition: border-color var(--transition), transform var(--transition);
}
.mini:hover {
  border-color: var(--border-hover);
  transform: translateY(-2px);
}
.mini__main { text-decoration: none; flex: 1; display: flex; flex-direction: column; }
.mini__media {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
}
.mini__cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.mini__media-logo {
  position: absolute;
  inset: 18%;
  width: auto;
  height: auto;
  max-width: 64%;
  max-height: 64%;
  margin: auto;
  object-fit: contain;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.35));
}
.mini__initials {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: #fff;
}
.mini__crest {
  position: absolute;
  left: 10px;
  bottom: 10px;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--bg-surface);
  border: 1px solid rgba(255,255,255,0.18);
}
.mini__crest img { width: 100%; height: 100%; object-fit: cover; }
.mini__status {
  position: absolute;
  top: 10px;
  right: 10px;
  font-family: var(--font-display);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #fff;
  background: rgba(10, 12, 15, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: var(--radius-pill);
  padding: 4px 10px;
}
.mini__status.is-live { color: #fff; background: var(--live); border-color: transparent; }
.mini__status.is-upcoming { color: #000; background: var(--accent); border-color: transparent; }
.mini__body { padding: 14px 16px 4px; }
.mini__name {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  margin: 0 0 4px;
  color: var(--text-primary);
  line-height: 1.2;
}
.mini__meta {
  font-size: 0.78rem;
  color: var(--text-secondary);
  margin: 0;
}
.mini__footer {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px 16px 16px;
}
.mini__shortcuts {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.mini__shortcuts a {
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
  padding: 5px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
}
.mini__shortcuts a:hover { color: var(--text-primary); border-color: var(--border-hover); }
.mini__go {
  align-self: flex-start;
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--accent);
}
.mini__go:hover { text-decoration: underline; }
</style>
