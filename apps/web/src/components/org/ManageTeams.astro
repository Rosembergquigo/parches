---
/**
 * Listado de equipos (o jugadores, en tenis) para editar nombre, color y contacto.
 * En tenis, foto y color salen del perfil del usuario, no se editan aquí.
 */
import type { RawTeam, RawTournament } from '../../lib/adapters';
import type { TeamEnrollment } from '../../lib/api';
import { toTitleCase } from '@parches/utils';
import { isIndividualSport } from '@parches/config';
import { DEFAULT_TEAM_COLORS } from '../../lib/tournamentWizard';
import { mediaUrl } from '../../lib/media';

interface Props {
  tournament: RawTournament;
  rosterByTeam?: Record<string, TeamEnrollment[]>;
  error?: string | null;
  saved?: boolean;
}

const { tournament, rosterByTeam = {}, error = null, saved = false } = Astro.props;
const individual = isIndividualSport(tournament.sport);

const groups = tournament.groups ?? [];
const matches = tournament.matches ?? [];

const teams = [...(tournament.teams ?? [])].sort((a, b) =>
  a.name.localeCompare(b.name, 'es')
);

function matchCount(teamId: string): number {
  return matches.filter(m => m.homeTeamId === teamId || m.awayTeamId === teamId).length;
}

function hexColor(team: RawTeam, index: number): string {
  const raw = (team.color ?? '').trim();
  if (/^#[0-9A-Fa-f]{6}$/.test(raw)) return raw;
  if (/^[0-9A-Fa-f]{6}$/.test(raw)) return `#${raw}`;
  return DEFAULT_TEAM_COLORS[index % DEFAULT_TEAM_COLORS.length];
}

const nextColor = DEFAULT_TEAM_COLORS[teams.length % DEFAULT_TEAM_COLORS.length];
---

<div class="ops">
  {saved && !error && (
    <p class="ops-ok" role="status">Guardado.</p>
  )}
  {error && (
    <p class="ops-err" role="alert">{error}</p>
  )}

  {teams.length === 0 && (
    <p class="ops-empty">
      {individual
        ? 'Este torneo no tiene jugadores. Agrega el primero abajo o deja que se inscriban desde la ficha.'
        : 'Este torneo no tiene equipos. Agrega el primero abajo.'}
    </p>
  )}

  {teams.length > 0 && (
    <section class="ops-stage">
      <h3 class="ops-stage__title">
        {teams.length}
        {individual
          ? (teams.length === 1 ? ' jugador' : ' jugadores')
          : (teams.length === 1 ? ' equipo' : ' equipos')}
      </h3>
      <div class="ops-table">
        {teams.map((team, i) => {
          const color = hexColor(team, i);
          const played = matchCount(team.id);
          const roster = rosterByTeam[team.id] ?? [];
          const activeCount = roster.filter(p => p.isActive).length;
          return (
            <div class="ops-block" id={`tm-${team.id}`}>
              <form method="POST" enctype="multipart/form-data" class="ops-row">
                <input type="hidden" name="intent" value="update" />
                <input type="hidden" name="teamId" value={team.id} />

                <div class="ops-row__top">
                  {individual ? (
                    <div class="tm-mark" style={`--tm-color: ${color}`}>
                      {team.logoUrl ? (
                        <img src={mediaUrl(team.logoUrl)} alt="" class="tm-mark__img" />
                      ) : (
                        <span>{team.shortName}</span>
                      )}
                    </div>
                  ) : (
                  <label class="tm-mark" style={`--tm-color: ${color}`}>
                    {team.logoUrl ? (
                      <img src={mediaUrl(team.logoUrl)} alt="" class="tm-mark__img" />
                    ) : (
                      <span>{team.shortName}</span>
                    )}
                    <input type="file" name="logo" class="tm-file"
                      accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"
                      aria-label={`Escudo de ${team.name}`} />
                  </label>
                  )}
                  <div class="ops-row__teams">
                    <span class="ops-row__home">{toTitleCase(team.name)}</span>
                    <span class="ops-row__names">
                      {played === 1 ? '1 partido' : `${played} partidos`}
                      {team.group?.label ? ` · ${team.group.label}` : ''}
                      {individual
                        ? (team.captainEmail ? ` · ${team.captainEmail}` : '')
                        : (team.captainName
                          ? ` · Capitán ${toTitleCase(team.captainName)}`
                          : ' · Sin capitán')}
                    </span>
                  </div>
                  <a href={`/teams/${team.id}`} class="tm-link">Ficha</a>
                </div>

                <div class:list={['ops-row__bottom', groups.length > 0 && 'ops-row__bottom--groups']}>
                  <label class="ops-field">
                    <span class="label">Nombre</span>
                    <input type="text" name="name" required value={team.name} class="ops-input" autocomplete="off" />
                  </label>
                  {!individual && (
                  <label class="ops-field ops-field--short">
                    <span class="label">Abrev.</span>
                    <input type="text" name="shortName" required maxlength="4" value={team.shortName}
                      class="ops-input" autocomplete="off" />
                  </label>
                  )}
                  {!individual && (
                  <label class="ops-field ops-field--color">
                    <span class="label">Color</span>
                    <input type="color" name="color" value={color} class="ops-color" aria-label={`Color de ${team.name}`} />
                  </label>
                  )}
                  {groups.length > 0 && (
                    <label class="ops-field">
                      <span class="label">Grupo</span>
                      <select name="groupId" class="ops-input">
                        <option value="">Sin grupo</option>
                        {groups.map(g => (
                          <option value={g.id} selected={team.groupId === g.id}>{g.label}</option>
                        ))}
                      </select>
                    </label>
                  )}
                </div>

                {individual ? (
                  <div class="ops-captain">
                    <p class="ops-captain__title">Contacto</p>
                    <label class="ops-field">
                      <span class="label">Correo</span>
                      <input type="email" name="captainEmail" required value={team.captainEmail ?? ''}
                        class="ops-input" autocomplete="email" />
                    </label>
                    <label class="ops-field">
                      <span class="label">Celular</span>
                      <input type="tel" name="captainPhone" required value={team.captainPhone ?? ''}
                        class="ops-input" autocomplete="tel" />
                    </label>
                  </div>
                ) : (
                <div class="ops-captain">
                  <p class="ops-captain__title">Capitán · contacto</p>
                  <label class="ops-field">
                    <span class="label">Nombre</span>
                    <input type="text" name="captainName" required value={team.captainName ?? ''}
                      class="ops-input" autocomplete="name" />
                  </label>
                  <label class="ops-field">
                    <span class="label">Correo</span>
                    <input type="email" name="captainEmail" required value={team.captainEmail ?? ''}
                      class="ops-input" autocomplete="email" />
                  </label>
                  <label class="ops-field">
                    <span class="label">Celular</span>
                    <input type="tel" name="captainPhone" required value={team.captainPhone ?? ''}
                      class="ops-input" autocomplete="tel" />
                  </label>
                </div>
                )}

                <div class="ops-row__foot">
                  {!individual && team.logoUrl && (
                    <label class="tm-clear">
                      <input type="checkbox" name="clearLogo" value="1" />
                      Quitar escudo
                    </label>
                  )}
                  <button type="submit" class="btn-accent" style="padding: 8px 14px; font-size: 0.75rem;">
                    Guardar
                  </button>
                  {played === 0 && (
                    <button
                      type="submit"
                      form={`del-tm-${team.id}`}
                      class="btn-ghost"
                      style="padding: 8px 12px; font-size: 0.75rem;"
                      onclick={individual ? "return confirm('¿Quitar este jugador?')" : "return confirm('¿Quitar este equipo?')"}
                    >
                      Quitar
                    </button>
                  )}
                </div>
              </form>
              {played === 0 && (
                <form id={`del-tm-${team.id}`} method="POST" hidden>
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="teamId" value={team.id} />
                </form>
              )}

              {!individual && (
              <details class="tm-squad">
                <summary class="tm-squad__summary">
                  <span>Plantilla</span>
                  <span class="tm-squad__count">
                    {activeCount} {activeCount === 1 ? 'jugador' : 'jugadores'}
                    {roster.length > activeCount ? ` · ${roster.length - activeCount} baja${roster.length - activeCount === 1 ? '' : 's'}` : ''}
                  </span>
                </summary>
                <div class="tm-squad__body">
                      {roster.length === 0 && (
                        <p class="tm-squad__empty">Aún no hay inscritos. Agrega el primero con su correo.</p>
                      )}

                      {roster.map(row => (
                        <div
                          class:list={['tm-player', !row.isActive && 'tm-player--off']}
                          id={`pl-${row.id}`}
                        >
                          <form method="POST" class="tm-player__form">
                            <input type="hidden" name="intent" value="updatePlayer" />
                            <input type="hidden" name="teamId" value={team.id} />
                            <input type="hidden" name="enrollmentId" value={row.id} />
                            <label class="ops-field tm-player__num">
                              <span class="label">#</span>
                              <input type="number" name="jerseyNumber" min="0" max="99"
                                value={row.jerseyNumber ?? ''} class="ops-input" />
                            </label>
                            <label class="ops-field">
                              <span class="label">Nombre</span>
                              <input type="text" name="name" required value={row.player.name}
                                class="ops-input" autocomplete="name" />
                            </label>
                            <label class="ops-field tm-player__mail">
                              <span class="label">Correo</span>
                              <input type="email" value={row.player.email} class="ops-input" readonly tabindex="-1" />
                            </label>
                            <label class="ops-field">
                              <span class="label">Posición</span>
                              <input type="text" name="position" value={row.position ?? ''}
                                class="ops-input" autocomplete="off" />
                            </label>
                            <label class="ops-field">
                              <span class="label">Celular</span>
                              <input type="tel" name="phone" value={row.player.phone ?? ''}
                                class="ops-input" autocomplete="tel" />
                            </label>
                            <div class="tm-player__actions">
                              {!row.isActive && <span class="tm-player__badge">Baja</span>}
                              <button type="submit" class="btn-accent tm-player__btn">Guardar</button>
                            </div>
                          </form>
                          {row.isActive ? (
                            <form method="POST" class="tm-player__drop">
                              <input type="hidden" name="intent" value="removePlayer" />
                              <input type="hidden" name="teamId" value={team.id} />
                              <input type="hidden" name="enrollmentId" value={row.id} />
                              <button
                                type="submit"
                                class="btn-ghost tm-player__btn"
                                onclick="return confirm('¿Dar de baja a este jugador?')"
                              >
                                Baja
                              </button>
                            </form>
                          ) : (
                            <form method="POST" class="tm-player__drop">
                              <input type="hidden" name="intent" value="reactivatePlayer" />
                              <input type="hidden" name="teamId" value={team.id} />
                              <input type="hidden" name="email" value={row.player.email} />
                              <input type="hidden" name="jerseyNumber" value={row.jerseyNumber ?? ''} />
                              <input type="hidden" name="position" value={row.position ?? ''} />
                              <button type="submit" class="btn-ghost tm-player__btn">Reactivar</button>
                            </form>
                          )}
                        </div>
                      ))}

                      <form method="POST" class="tm-add">
                        <input type="hidden" name="intent" value="enroll" />
                        <input type="hidden" name="teamId" value={team.id} />
                        <label class="ops-field tm-add__mail">
                          <span class="label">Correo</span>
                          <input type="email" name="email" required placeholder="jugador@correo.com"
                            class="ops-input" autocomplete="email" />
                        </label>
                        <label class="ops-field">
                          <span class="label">Nombre</span>
                          <input type="text" name="name" placeholder="Si es nuevo"
                            class="ops-input" autocomplete="name" />
                        </label>
                        <label class="ops-field tm-player__num">
                          <span class="label">#</span>
                          <input type="number" name="jerseyNumber" min="0" max="99" class="ops-input" />
                        </label>
                        <label class="ops-field">
                          <span class="label">Posición</span>
                          <input type="text" name="position" class="ops-input" autocomplete="off" />
                        </label>
                        <label class="ops-field">
                          <span class="label">Celular</span>
                          <input type="tel" name="phone" class="ops-input" autocomplete="tel" />
                        </label>
                        <button type="submit" class="btn-accent tm-add__btn">Inscribir</button>
                      </form>
                </div>
              </details>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  <section class="ops-stage">
    <h3 class="ops-stage__title">{individual ? 'Agregar jugador' : 'Agregar equipo'}</h3>
    <form method="POST" enctype="multipart/form-data" class="ops-add">
      <input type="hidden" name="intent" value="create" />
      <div class:list={['ops-add__row', individual && 'ops-add__row--player', groups.length > 0 && 'ops-add__row--groups']}>
        <label class="ops-field">
          <span class="label">Nombre</span>
          <input
            type="text"
            name="name"
            required
            placeholder={individual ? 'Nombre del jugador' : 'Nombre del equipo'}
            class="ops-input"
            autocomplete={individual ? 'name' : 'off'}
          />
        </label>
        {!individual && (
          <label class="ops-field ops-field--short">
            <span class="label">Abrev.</span>
            <input type="text" name="shortName" required maxlength="4" placeholder="ABC" class="ops-input" autocomplete="off" />
          </label>
        )}
        {!individual && (
        <label class="ops-field ops-field--color">
          <span class="label">Color</span>
          <input type="color" name="color" value={nextColor} class="ops-color"
            aria-label="Color del equipo" />
        </label>
        )}
        {!individual && (
        <label class="ops-field ops-field--logo">
          <span class="label">Escudo</span>
          <input type="file" name="logo" class="ops-input ops-file"
            accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" />
        </label>
        )}
        {groups.length > 0 && (
          <label class="ops-field">
            <span class="label">Grupo</span>
            <select name="groupId" class="ops-input">
              <option value="">Sin grupo</option>
              {groups.map(g => (
                <option value={g.id}>{g.label}</option>
              ))}
            </select>
          </label>
        )}
        {!individual && (
          <button type="submit" class="btn-accent" style="padding: 10px 18px; align-self: end;">
            Agregar
          </button>
        )}
      </div>
      {individual ? (
        <div class="ops-captain ops-captain--player">
          <p class="ops-captain__title">Contacto · la foto sale de su perfil</p>
          <label class="ops-field">
            <span class="label">Correo</span>
            <input type="email" name="captainEmail" required placeholder="jugador@correo.com"
              class="ops-input" autocomplete="email" />
          </label>
          <label class="ops-field">
            <span class="label">Celular</span>
            <input type="tel" name="captainPhone" required placeholder="300 000 0000"
              class="ops-input" autocomplete="tel" />
          </label>
          <button type="submit" class="btn-accent" style="padding: 10px 18px; align-self: end;">
            Agregar
          </button>
        </div>
      ) : (
        <div class="ops-captain">
          <p class="ops-captain__title">Capitán · contacto</p>
          <label class="ops-field">
            <span class="label">Nombre</span>
            <input type="text" name="captainName" required placeholder="Nombre completo"
              class="ops-input" autocomplete="name" />
          </label>
          <label class="ops-field">
            <span class="label">Correo</span>
            <input type="email" name="captainEmail" required placeholder="capitan@correo.com"
              class="ops-input" autocomplete="email" />
          </label>
          <label class="ops-field">
            <span class="label">Celular</span>
            <input type="tel" name="captainPhone" required placeholder="300 000 0000"
              class="ops-input" autocomplete="tel" />
          </label>
        </div>
      )}
    </form>
  </section>
</div>

<style>
.ops-ok {
  background: rgba(34,197,94,0.12);
  border: 1px solid rgba(34,197,94,0.35);
  color: #86efac;
  border-radius: var(--radius-md);
  padding: 10px 14px;
  margin: 0 0 16px;
  font-size: 0.875rem;
}
.ops-err {
  background: rgba(255,59,59,0.1);
  border: 1px solid rgba(255,59,59,0.3);
  color: #ff6b6b;
  border-radius: var(--radius-md);
  padding: 10px 14px;
  margin: 0 0 16px;
  font-size: 0.875rem;
}
.ops-empty {
  color: var(--text-secondary);
  margin: 0 0 24px;
}
.ops-stage { margin-bottom: 28px; }
.ops-stage__title {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  margin: 0 0 10px;
}
.ops-table {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
}
.ops-block {
  min-width: 0;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.ops-row {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px 14px;
  background: transparent;
  border: none;
  height: auto;
}
.ops-row__top {
  display: flex;
  align-items: center;
  gap: 10px;
}
.ops-row__teams { flex: 1; min-width: 0; }
.ops-row__home {
  font-family: var(--font-display);
  font-weight: 800;
  letter-spacing: 0.04em;
}
.ops-row__names {
  display: block;
  font-size: 0.7rem;
  color: var(--text-muted);
}
.ops-row__bottom {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 88px 56px;
  gap: 8px;
}
.ops-row__bottom--groups {
  grid-template-columns: minmax(0, 1fr) 88px 56px minmax(0, 0.8fr);
}
.ops-add {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px 14px;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
}
.ops-add__row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 88px 56px minmax(140px, 0.8fr) auto;
  gap: 8px;
  align-items: end;
}
.ops-add__row--groups {
  grid-template-columns: minmax(0, 1fr) 88px 56px minmax(140px, 0.8fr) minmax(0, 0.8fr) auto;
}
.ops-add__row--player {
  grid-template-columns: minmax(0, 1.2fr) 56px minmax(140px, 0.8fr);
}
.ops-add__row--player.ops-add__row--groups {
  grid-template-columns: minmax(0, 1.2fr) 56px minmax(140px, 0.8fr) minmax(0, 0.8fr);
}
.ops-captain {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr) minmax(120px, 0.8fr);
  gap: 8px;
}
.ops-captain--player {
  grid-template-columns: minmax(0, 1.3fr) minmax(140px, 0.8fr) auto;
  align-items: end;
}
.ops-captain__title {
  grid-column: 1 / -1;
  margin: 2px 0 0;
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--text-muted);
}
.ops-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.ops-field--short { width: 88px; }
.ops-field--color { width: 56px; }
.ops-field--logo { min-width: 0; }
.ops-input {
  background: var(--bg-overlay);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 0.85rem;
  padding: 8px 10px;
  outline: none;
  width: 100%;
}
.ops-input:focus { border-color: var(--accent); }
.ops-file {
  padding: 6px 10px;
  font-size: 0.75rem;
}
.ops-color {
  appearance: none;
  -webkit-appearance: none;
  width: 100%;
  height: 36px;
  padding: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--bg-overlay);
  cursor: pointer;
  overflow: hidden;
}
.ops-color::-webkit-color-swatch-wrapper { padding: 4px; }
.ops-color::-webkit-color-swatch { border: none; border-radius: 999px; }
.tm-mark {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  background: color-mix(in srgb, var(--tm-color) 22%, var(--bg-overlay));
  color: var(--tm-color);
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  overflow: hidden;
  cursor: pointer;
  border: 1px dashed color-mix(in srgb, var(--tm-color) 45%, var(--border));
}
.tm-mark:hover { border-style: solid; }
.tm-mark__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.tm-file {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
  height: 100%;
}
.tm-clear {
  margin-right: auto;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  color: var(--text-muted);
  cursor: pointer;
}
.tm-link {
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--accent);
  flex-shrink: 0;
}
.ops-row__foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 6px;
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px solid var(--border);
}

.tm-squad {
  border-top: 1px solid var(--border);
}
.tm-squad__summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px 14px;
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  user-select: none;
}
.tm-squad__summary::-webkit-details-marker { display: none; }
.tm-squad__summary::marker { content: ''; }
.tm-squad__summary::after {
  content: '';
  width: 7px;
  height: 7px;
  flex-shrink: 0;
  border-right: 2px solid var(--text-muted);
  border-bottom: 2px solid var(--text-muted);
  transform: rotate(45deg);
  transition: transform 0.15s ease;
}
.tm-squad[open] > .tm-squad__summary::after {
  transform: rotate(225deg);
  margin-top: 4px;
}
.tm-squad__count { font-weight: 600; margin-right: auto; }
.tm-squad__body {
  padding: 0 14px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.tm-squad__empty {
  margin: 0;
  font-size: 0.8rem;
