---
/**
 * TeamMatchHistory.astro — historial de partidos del equipo.
 * Resalta el nombre del equipo actual; linkea a /matches/[id].
 */
import type { TeamMatchItem } from '../../data/mock';

interface Props {
  matches: TeamMatchItem[];
  teamId: string;
}

const { matches, teamId } = Astro.props;

function formatScheduled(iso?: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  const now = new Date();
  const diffH = (d.getTime() - now.getTime()) / 3_600_000;
  if (diffH < 24) {
    return `Hoy · ${d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
  }
  if (diffH < 48) {
    return `Mañana · ${d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })}`;
  }
  return d.toLocaleDateString('es-CO', { day: 'numeric', month: 'short' });
}

const statusLabel: Record<string, string> = {
  LIVE: 'En vivo',
  SCHEDULED: 'Programado',
  FINISHED: 'Finalizado',
};
---

<section class="tmh" aria-label="Partidos del equipo">
  <h2 class="tmh__title">Partidos</h2>

  {matches.length === 0 && (
    <p class="tmh__empty">Sin partidos registrados</p>
  )}

  <div class="tmh__list">
    {matches.map(m => {
      const homeWins = m.status !== 'SCHEDULED' && m.homeScore > m.awayScore;
      const awayWins = m.status !== 'SCHEDULED' && m.awayScore > m.homeScore;
      const isHome = m.homeTeam.id === teamId;
      const clockLabel =
        m.status === 'LIVE' ? (m.clock ?? '') :
        m.status === 'FINISHED' ? 'FT' :
        formatScheduled(m.scheduledAt);

      return (
        <a
          href={`/matches/${m.matchId}`}
          class:list={['tmh__row', m.status === 'LIVE' && 'tmh__row--live']}
        >
          <div class:list={['tmh__status', `tmh__status--${m.status.toLowerCase()}`]}>
            {m.status === 'LIVE' && <span class="tmh__dot" aria-hidden="true" />}
            {statusLabel[m.status]}
          </div>

          <div class="tmh__teams">
            <span class:list={['tmh__team', isHome && 'tmh__team--focus', homeWins && 'tmh__team--win']}>
              {m.homeTeam.shortName}
            </span>
            <div class="tmh__score">
              {m.status === 'SCHEDULED' ? (
                <span class="tmh__vs">vs</span>
              ) : (
                <>
                  <span class:list={[homeWins && 'tmh__score--win']}>{m.homeScore}</span>
                  <span class="tmh__sep">—</span>
                  <span class:list={[awayWins && 'tmh__score--win']}>{m.awayScore}</span>
                </>
              )}
            </div>
            <span class:list={['tmh__team', !isHome && 'tmh__team--focus', awayWins && 'tmh__team--win']}>
              {m.awayTeam.shortName}
            </span>
          </div>

          <div class="tmh__meta">
            {m.roundLabel && <span class="tmh__round">{m.roundLabel}</span>}
            <span class="tmh__clock">{clockLabel}</span>
          </div>

          <span class="tmh__arrow" aria-hidden="true">→</span>
        </a>
      );
    })}
  </div>
</section>

<style>
.tmh {
  padding: 0 24px;
  margin-bottom: 32px;
}
.tmh__title {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-primary);
  margin-bottom: 16px;
}
.tmh__empty {
  font-size: 0.85rem;
  color: var(--text-muted);
  padding: 12px 0;
}
.tmh__list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.tmh__row {
  display: grid;
  grid-template-columns: 100px 1fr auto 20px;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: border-color var(--transition);
}
.tmh__row:hover { border-color: var(--border-hover); }
.tmh__row--live { border-color: rgba(255,59,59,0.35); }

.tmh__status {
  font-family: var(--font-display);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 5px;
}
.tmh__status--live { color: var(--live); }
.tmh__status--scheduled { color: var(--text-secondary); }
.tmh__status--finished { color: var(--text-muted); }
.tmh__dot {
  width: 5px; height: 5px;
  background: var(--live);
  border-radius: 50%;
  animation: pulse-dot 1.2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.65)}
}

.tmh__teams {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
.tmh__team {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-secondary);
  min-width: 36px;
}
.tmh__team--focus { color: var(--text-primary); }
.tmh__team--win { color: var(--accent); }
.tmh__score {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 900;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 4px;
  min-width: 48px;
  justify-content: center;
}
.tmh__score--win { color: var(--accent); }
.tmh__sep { color: var(--text-muted); font-weight: 600; }
.tmh__vs {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  text-transform: uppercase;
}

.tmh__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}
.tmh__round {
  font-family: var(--font-display);
  font-size: 0.55rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
  max-width: 140px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tmh__clock {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
}
.tmh__arrow {
  color: var(--text-muted);
  font-size: 0.85rem;
}

@media (max-width: 640px) {
  .tmh__row {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
  }
  .tmh__status { grid-column: 1; }
  .tmh__arrow { grid-column: 2; grid-row: 1; }
  .tmh__teams { grid-column: 1 / -1; }
  .tmh__meta {
    grid-column: 1 / -1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
}
</style>
