---
/**
 * Header de la ficha pública de una cancha / estadio.
 */
import {
  VENUE_KIND_LABEL,
  VENUE_SPORT_LABEL,
  formatCapacity,
  type Venue,
} from '../../data/venues';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;
const capacity = formatCapacity(venue.capacity);
---

<header class="vhero">
  <img class="vhero__bg" src={venue.coverImageUrl} alt="" aria-hidden="true" />
  <div class="vhero__scrim" aria-hidden="true"></div>

  <div class="vhero__inner">
    <nav class="vhero__crumb" aria-label="Navegación de migas">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <a href="/venues">Canchas</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{venue.name}</span>
    </nav>

    <p class="vhero__kind">{VENUE_KIND_LABEL[venue.kind]}</p>
    <h1 class="vhero__name">{venue.name}</h1>
    <p class="vhero__meta">
      {venue.sports.map(s => VENUE_SPORT_LABEL[s] ?? s).join(' · ')}
      {' · '}
      {[venue.neighborhood, venue.city].filter(Boolean).join(', ')}
      {capacity ? ` · ${capacity}` : ''}
    </p>
  </div>
</header>

<style>
.vhero {
  position: relative;
  min-height: 280px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  border-bottom: 1px solid var(--border);
}
.vhero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.vhero__scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(10, 12, 15, 0.25) 0%, rgba(10, 12, 15, 0.88) 100%);
}
.vhero__inner {
  position: relative;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 28px 24px 32px;
}
.vhero__crumb {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-secondary);
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0 0 18px;
}
.vhero__crumb a { color: var(--accent); }
.vhero__kind {
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 8px;
}
.vhero__name {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 4vw, 2.6rem);
  font-weight: 800;
  letter-spacing: 0.02em;
  line-height: 1.05;
  margin: 0 0 10px;
  max-width: 18ch;
}
.vhero__meta {
  color: var(--text-secondary);
  font-size: 0.92rem;
  margin: 0;
}

@media (max-width: 640px) {
  .vhero { min-height: 240px; }
  .vhero__name { max-width: none; }
}
</style>
