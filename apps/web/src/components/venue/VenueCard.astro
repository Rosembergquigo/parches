---
/**
 * Tarjeta pública de cancha / estadio.
 */
import {
  VENUE_KIND_LABEL,
  VENUE_SPORT_LABEL,
  type Venue,
} from '../../data/venues';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;
const sports = venue.sports.map(s => VENUE_SPORT_LABEL[s] ?? s).join(' · ');
---

<a href={`/venues/${venue.slug}`} class="vcard">
  <div class="vcard__media">
    <img src={venue.coverImageUrl} alt="" loading="lazy" />
    <span class="vcard__kind">{VENUE_KIND_LABEL[venue.kind]}</span>
  </div>
  <div class="vcard__body">
    <p class="vcard__sports">{sports}</p>
    <h3 class="vcard__name">{venue.name}</h3>
    <p class="vcard__place">
      {[venue.neighborhood, venue.city].filter(Boolean).join(', ')}
    </p>
    {venue.surface && <p class="vcard__surface">{venue.surface}</p>}
  </div>
</a>

<style>
.vcard {
  display: flex;
  flex-direction: column;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  text-decoration: none;
  transition: border-color var(--transition), transform var(--transition);
}
.vcard:hover {
  border-color: var(--border-hover);
  transform: translateY(-2px);
}
.vcard__media {
  position: relative;
  aspect-ratio: 16 / 10;
  background: var(--bg-raised);
}
.vcard__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.vcard__kind {
  position: absolute;
  left: 10px;
  bottom: 10px;
  font-family: var(--font-display);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #fff;
  background: rgba(10, 12, 15, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: var(--radius-pill);
  padding: 4px 10px;
}
.vcard__body {
  padding: 14px 16px 16px;
}
.vcard__sports {
  font-family: var(--font-display);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent);
  margin: 0 0 6px;
}
.vcard__name {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  line-height: 1.2;
  margin: 0 0 6px;
  color: var(--text-primary);
}
.vcard__place {
  font-size: 0.82rem;
  color: var(--text-secondary);
  margin: 0;
}
.vcard__surface {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin: 8px 0 0;
}
</style>
