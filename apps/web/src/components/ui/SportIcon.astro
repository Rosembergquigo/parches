---
/**
 * SportIcon.astro
 * SVG inline por deporte. Sin fuentes de iconos externas.
 * Recibe size en px y color como stroke color.
 */
import type { Sport } from '../../data/mock';

interface Props {
  sport: Sport | 'all';
  size?: number;
  stroke?: string;
  class?: string;
}

const { sport, size = 20, stroke = 'rgba(255,255,255,0.7)', class: cls = '' } = Astro.props;
const s = size;
---

{sport === 'all' && (
  <svg width={s} height={s} viewBox="0 0 24 24" fill="none" stroke={stroke}
    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
    <rect x="3" y="3" width="7" height="7" rx="1"/>
    <rect x="14" y="3" width="7" height="7" rx="1"/>
    <rect x="3" y="14" width="7" height="7" rx="1"/>
    <rect x="14" y="14" width="7" height="7" rx="1"/>
  </svg>
)}

{sport === 'football' && (
  <svg width={s} height={s} viewBox="0 0 32 32" fill="none" stroke={stroke}
    stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
    <circle cx="16" cy="16" r="13"/>
    <polygon points="16,8 19.5,13 25,13 21,17.5 23,23 16,19 9,23 11,17.5 7,13 12.5,13"
      fill="rgba(255,255,255,0.1)" stroke={stroke} stroke-width="1"/>
  </svg>
)}

{sport === 'basketball' && (
  <svg width={s} height={s} viewBox="0 0 32 32" fill="none" stroke={stroke}
    stroke-width="1.4" stroke-linecap="round" class={cls} aria-hidden="true">
    <circle cx="16" cy="16" r="13"/>
    <path d="M3 16h26"/>
    <path d="M16 3a18 18 0 0 1 0 26"/>
    <path d="M16 3a18 18 0 0 0 0 26"/>
  </svg>
)}

{sport === 'tennis' && (
  <svg width={s} height={s} viewBox="0 0 32 32" fill="none" stroke={stroke}
    stroke-width="1.4" stroke-linecap="round" class={cls} aria-hidden="true">
    <circle cx="16" cy="16" r="13"/>
    <path d="M6 8a10 10 0 0 1 0 16"/>
    <path d="M26 8a10 10 0 0 0 0 16"/>
  </svg>
)}

{sport === 'volleyball' && (
  <svg width={s} height={s} viewBox="0 0 32 32" fill="none" stroke={stroke}
    stroke-width="1.4" stroke-linecap="round" class={cls} aria-hidden="true">
    <circle cx="16" cy="16" r="13"/>
    <path d="M16 3c4 4 4 10 0 14"/>
    <path d="M16 3c-4 4-4 10 0 14"/>
    <path d="M3 14c4 2 10 2 14-1"/>
    <path d="M16 17c4 4 10 4 13 2"/>
  </svg>
)}

{sport === 'baseball' && (
  <svg width={s} height={s} viewBox="0 0 32 32" fill="none" stroke={stroke}
    stroke-width="1.4" stroke-linecap="round" class={cls} aria-hidden="true">
    <circle cx="16" cy="16" r="13"/>
    <path d="M10 5.5c2 4 2 17 0 21"/>
    <path d="M22 5.5c-2 4-2 17 0 21"/>
    <path d="M6 11c4 2 16 2 20 0"/>
    <path d="M6 21c4-2 16-2 20 0"/>
  </svg>
)}

{sport === 'hockey' && (
  <svg width={s} height={s} viewBox="0 0 32 32" fill="none" stroke={stroke}
    stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
    <circle cx="16" cy="16" r="13"/>
    <path d="M10 10 L22 10 L22 18 Q22 22 16 22 Q10 22 10 18 Z" fill="rgba(255,255,255,0.08)"/>
    <path d="M13 10 L13 19"/>
    <path d="M19 10 L19 19"/>
  </svg>
)}