---
/**
 * pages/teams/[id].astro — página de equipo.
 *
 * SSR. 404 si el equipo no existe (GET /api/teams/:id devuelve 404).
 * La plantilla (squad) todavía no tiene datos reales — requiere
 * PlayerEnrollment, que no está cargado en el seed aún — así que esa
 * sección simplemente no se renderiza (squad.length === 0).
 */
import Base from '../../layouts/Base.astro';
import TeamHero from '../../components/team/TeamHero.astro';
import TeamSquad from '../../components/team/TeamSquad.astro';
import TeamMatchHistory from '../../components/team/TeamMatchHistory.astro';
import TeamStatsBar from '../../components/team/TeamStatsBar.astro';
import { getTeamDetail } from '../../lib/api';

const { id } = Astro.params;
const team = await getTeamDetail(id!, Astro.request);

if (!team) return Astro.redirect('/404');

const hasStats = !!team.standing;
const hasSquad = team.squad.length > 0;
const hasMatches = team.recentMatches.length > 0;
---

<Base
  title={`${team.name} | ${team.tournamentName}`}
  description={`Plantilla, partidos y estadísticas de ${team.name} en ${team.tournamentName}.`}
>
  <TeamHero team={team} />

  <main class="t-page">
    <div class="t-page__inner">
      <nav class="t-tabs" id="tTabs" aria-label="Secciones del equipo">
        {hasSquad && <a href="#plantilla" class="t-tab">Plantilla</a>}
        {hasMatches && <a href="#partidos" class="t-tab">Partidos</a>}
        {hasStats && <a href="#estadisticas" class="t-tab">Estadísticas</a>}
      </nav>

      {hasSquad && (
        <section id="plantilla" class="t-section" aria-label="Plantilla">
          <TeamSquad players={team.squad} />
        </section>
      )}

      {hasMatches && (
        <section id="partidos" class="t-section" aria-label="Partidos">
          <TeamMatchHistory matches={team.recentMatches} teamId={team.id} />
        </section>
      )}

      {hasStats && team.standing && (
        <section id="estadisticas" class="t-section" aria-label="Estadísticas">
          <TeamStatsBar standing={team.standing} sport={team.sport} />
        </section>
      )}
    </div>
  </main>
</Base>

<style>
.t-page {
  flex: 1;
  padding-bottom: 60px;
}
.t-page__inner {
  max-width: 1280px;
  margin: 0 auto;
}
.t-tabs {
  display: flex;
  gap: 4px;
  padding: 14px 24px;
  position: sticky;
  top: 50px;
  z-index: 10;
  background: rgba(10,12,15,0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
  margin-bottom: 4px;
}
.t-tab {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-secondary);
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  text-decoration: none;
  transition: color var(--transition), background var(--transition);
}
.t-tab:hover {
  color: var(--text-primary);
  background: var(--bg-raised);
}
.t-section {
  padding-top: 28px;
  scroll-margin-top: 100px;
}
</style>

<script>
  (function () {
    const tabs = document.querySelectorAll<HTMLAnchorElement>('.t-tab');
    const sections = document.querySelectorAll<HTMLElement>('.t-section');
    if (!tabs.length || !sections.length) return;

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tabs.forEach(tab => {
              const isActive = tab.getAttribute('href') === `#${id}`;
              tab.style.color = isActive ? 'var(--accent)' : '';
              tab.style.background = isActive ? 'var(--accent-dim)' : '';
            });
          }
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );

    sections.forEach(s => observer.observe(s));
  })();
</script>
