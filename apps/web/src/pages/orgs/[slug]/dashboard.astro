<script>
  document.querySelectorAll<HTMLInputElement>('.t-logo__file').forEach(input => {
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      if (!file) return;
      const mark = input.closest('.t-logo__mark');
      if (!mark) return;
      const url = URL.createObjectURL(file);
      let img = mark.querySelector('img');
      if (!img) {
        img = document.createElement('img');
        img.className = 't-logo__img';
        mark.querySelector('span')?.remove();
        mark.insertBefore(img, input);
      }
      img.src = url;
      img.alt = '';
    });
  });

  document.querySelectorAll<HTMLInputElement>('.t-cover__file').forEach(input => {
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      if (!file) return;
      const preview = input.closest('.t-cover__preview');
      if (!preview) return;
      const url = URL.createObjectURL(file);
      let img = preview.querySelector('img');
      if (!img) {
        img = document.createElement('img');
        img.className = 't-cover__img';
        preview.querySelector('span')?.remove();
        preview.insertBefore(img, input);
      }
      img.src = url;
      img.alt = '';
    });
  });

  const picker = document.getElementById('brandColorPicker') as HTMLInputElement | null;
  const text = document.getElementById('brandColor') as HTMLInputElement | null;
  if (picker && text) {
    picker.addEventListener('input', () => { text.value = picker.value; });
    text.addEventListener('input', () => {
      if (/^#[0-9A-Fa-f]{6}$/.test(text.value)) picker.value = text.value;
    });
  }
</script>
