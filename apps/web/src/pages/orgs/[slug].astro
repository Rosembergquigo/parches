---
/**
 * Ficha de empresa: lista cada torneo en minicard.
 * Si eres miembro, los atajos abren el dashboard de ese campeonato.
 */
import Base from '../../layouts/Base.astro';
import OrgTournamentCard from '../../components/org/OrgTournamentCard.astro';
import { getOrganization } from '../../lib/api';
import { canAdminOrg } from '../../lib/session';

const { slug } = Astro.params;
const org = await getOrganization(slug!, Astro.request);
if (!org) return Astro.redirect('/404');

const initials = org.name
  .split(' ')
  .filter(w => w.length > 2)
  .slice(0, 2)
  .map(w => w[0]!.toUpperCase())
  .join('') || org.name.slice(0, 2).toUpperCase();

const markBg = org.brandColor ?? '#1e232b';
const canManage = !!org.myRole;
const canAdmin = canAdminOrg(org.myRole);
const justCreated = Astro.url.searchParams.get('ok') === 'creada';
---

<Base
  title={`${org.name} | Chapi`}
  description={org.description ?? `${org.name} — torneos en Chapi.`}
>
  <header class="org-hero" style={org.brandColor ? `background: linear-gradient(135deg, ${org.brandColor}22 0%, #0a0c0f 70%)` : undefined}>
    <div class="org-hero__inner">
      <div
        class="org-hero__mark"
        style={`background: ${markBg}`}
        aria-hidden="true"
      >
        {org.logoUrl ? <img src={org.logoUrl} alt="" /> : initials}
      </div>
      <div class="org-hero__text">
        <p class="org-hero__kicker">Empresa</p>
        <h1 class="org-hero__name">{org.name}</h1>
        <p class="org-hero__meta">
          {[org.city, `${org.tournamentCount} torneo${org.tournamentCount === 1 ? '' : 's'}`, `${org.memberCount} miembro${org.memberCount === 1 ? '' : 's'}`]
            .filter(Boolean)
            .join(' · ')}
        </p>
        {org.description && <p class="org-hero__desc">{org.description}</p>}
      </div>
      {(canManage || canAdmin) && (
        <div class="org-hero__actions">
          {canAdmin && (
            <a href={`/orgs/${org.slug}/settings`} class="btn-ghost">Ajustes</a>
          )}
          {canManage && (
            <a href={`/orgs/${org.slug}/tournaments/new`} class="btn-accent org-hero__cta">
              Crear torneo
            </a>
          )}
        </div>
      )}
    </div>
  </header>

  <main class="org-page">
    <div class="org-page__inner">
      {justCreated && canAdmin && (
        <p class="org-banner">
          Empresa creada. Completa logo y textos en
          <a href={`/orgs/${org.slug}/settings`}>Ajustes</a>.
        </p>
      )}
      <div class="org-page__title-row">
        <h2 class="org-page__title">Torneos</h2>
      </div>
      {org.tournaments.length === 0 ? (
        <p class="org-empty">
          Esta empresa aún no tiene torneos publicados.
          {canManage && (
            <>
              {' '}
              <a href={`/orgs/${org.slug}/tournaments/new`}>Crea el primero</a>.
            </>
          )}
        </p>
      ) : (
        <div class="org-grid">
          {org.tournaments.map(t => (
            <OrgTournamentCard tournament={t} orgSlug={org.slug} canManage={canManage} />
          ))}
        </div>
      )}
    </div>
  </main>
</Base>

<style>
.org-hero {
  padding: 36px 24px 28px;
  border-bottom: 1px solid var(--border);
}
.org-hero__inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 20px;
}
.org-hero__mark {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
  border: 1px solid var(--border);
}
.org-hero__mark img { width: 100%; height: 100%; object-fit: cover; }
.org-hero__text { flex: 1; min-width: 0; }
.org-hero__kicker {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--text-muted);
  margin: 0 0 4px;
}
.org-hero__name {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 800;
  letter-spacing: 0.02em;
  margin: 0;
}
.org-hero__meta {
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
  margin: 6px 0 0;
}
.org-hero__desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin: 10px 0 0;
  max-width: 56ch;
  line-height: 1.5;
}
.org-hero__actions {
  margin-left: auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.org-hero__cta { flex-shrink: 0; }
.org-page { flex: 1; padding-bottom: 60px; }
.org-page__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px 24px 8px;
}
.org-page__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 16px;
}
.org-page__title {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  margin: 0;
}
.org-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 12px;
}
.org-empty {
  padding: 32px 8px;
  color: var(--text-muted);
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-align: center;
}
.org-empty a { color: var(--accent); }
.org-banner {
  margin: 0 0 16px;
  padding: 12px 14px;
  background: var(--bg-surface);
  border: 1px dashed var(--border);
  border-radius: var(--radius-md);
  font-size: 0.88rem;
  color: var(--text-secondary);
}
.org-banner a { color: var(--accent); }
@media (max-width: 600px) {
  .org-hero__inner { flex-direction: column; align-items: flex-start; }
  .org-hero__actions { margin-left: 0; }
}
</style>
