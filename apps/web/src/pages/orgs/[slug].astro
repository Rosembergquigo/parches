---
/**
 * Ficha pública de la empresa: marca + torneos en Chapi.
 * El dashboard es atajo de miembro, no el destino del visitante.
 */
import Base from '../../layouts/Base.astro';
import OrgTournamentCard from '../../components/org/OrgTournamentCard.astro';
import SearchBar from '../../components/ui/SearchBar.astro';
import { getOrganization } from '../../lib/api';
import { canAdminOrg } from '../../lib/session';
import { readSearchQuery } from '../../lib/search';

const { slug } = Astro.params;
const org = await getOrganization(slug!, Astro.request);
if (!org) return Astro.redirect('/404');

const initials = org.name
  .split(' ')
  .filter(w => w.length > 2)
  .slice(0, 2)
  .map(w => w[0]!.toUpperCase())
  .join('') || org.name.slice(0, 2).toUpperCase();

const markBg = org.brandColor ?? '#1e232b';
const canManage = !!org.myRole;
const canAdmin = canAdminOrg(org.myRole);
const justCreated = Astro.url.searchParams.get('ok') === 'creada';
const liveTournament = org.tournaments.find(t => t.status === 'LIVE');
const publicCta = liveTournament
  ? { href: `/tournaments/${liveTournament.slug}`, label: 'Ver en vivo', live: true as const }
  : org.tournaments.length > 0
    ? { href: '#torneos', label: 'Ver torneos', live: false as const }
    : null;
const tournamentLabel = `${org.tournamentCount} torneo${org.tournamentCount === 1 ? '' : 's'}`;
const shareTitle = `${org.name} | Chapi`;
const shareDescription = org.description?.trim()
  || `${org.name}${org.city ? ` · ${org.city}` : ''} — ${tournamentLabel} en Chapi.`;

type EstadoFiltro = 'all' | 'LIVE' | 'UPCOMING' | 'FINISHED';
const ESTADOS: { id: EstadoFiltro; slug: string | null; label: string }[] = [
  { id: 'all', slug: null, label: 'Todos' },
  { id: 'LIVE', slug: 'en-vivo', label: 'En vivo' },
  { id: 'UPCOMING', slug: 'proximos', label: 'Próximos' },
  { id: 'FINISHED', slug: 'cerrados', label: 'Cerrados' },
];
const estadoRaw = Astro.url.searchParams.get('estado');
const estadoActivo = ESTADOS.find(e => e.slug === estadoRaw) ?? ESTADOS[0]!;
const q = readSearchQuery(Astro.url);
const visibleTournaments = estadoActivo.id === 'all'
  ? org.tournaments
  : org.tournaments.filter(t => t.status === estadoActivo.id);
const estadoCounts: Record<EstadoFiltro, number> = {
  all: org.tournaments.length,
  LIVE: org.tournaments.filter(t => t.status === 'LIVE').length,
  UPCOMING: org.tournaments.filter(t => t.status === 'UPCOMING').length,
  FINISHED: org.tournaments.filter(t => t.status === 'FINISHED').length,
};
const emptyByEstado: Record<Exclude<EstadoFiltro, 'all'>, string> = {
  LIVE: 'No hay torneos en vivo.',
  UPCOMING: 'No hay torneos próximos.',
  FINISHED: 'No hay torneos cerrados.',
};
const emptyFilterMessage = estadoActivo.id === 'all'
  ? ''
  : emptyByEstado[estadoActivo.id];
const orgSlug = org.slug;
function chipHref(estadoSlug: string | null) {
  const params = new URLSearchParams();
  if (estadoSlug) params.set('estado', estadoSlug);
  if (q) params.set('q', q);
  const qs = params.toString();
  return `/orgs/${orgSlug}${qs ? `?${qs}` : ''}#torneos`;
}
---

<Base
  title={shareTitle}
  description={shareDescription}
  ogImage={org.logoUrl ?? undefined}
>
  <header class="org-hero" style={org.brandColor ? `background: linear-gradient(135deg, ${org.brandColor}22 0%, #0a0c0f 70%)` : undefined}>
    <div class="org-hero__inner">
      <div
        class="org-hero__mark"
        style={`background: ${markBg}`}
        aria-hidden="true"
      >
        {org.logoUrl ? <img src={org.logoUrl} alt="" /> : initials}
      </div>
      <div class="org-hero__text">
        {org.city && <p class="org-hero__kicker">{org.city}</p>}
        <h1 class="org-hero__name">{org.name}</h1>
        <p class="org-hero__meta">{tournamentLabel}</p>
        {org.description && <p class="org-hero__desc">{org.description}</p>}
      </div>
      <div class="org-hero__actions">
        {canManage ? (
          <>
            {canAdmin && (
              <a href={`/orgs/${org.slug}/settings`} class="btn-ghost">Ajustes</a>
            )}
            <a href={`/orgs/${org.slug}/tournaments/new`} class="btn-accent org-hero__cta">
              Crear torneo
            </a>
          </>
        ) : publicCta && (
          <a
            href={publicCta.href}
            class:list={['btn-accent', 'org-hero__cta', publicCta.live && 'org-hero__cta--live']}
            title={liveTournament?.name}
          >
            {publicCta.live && <span class="org-hero__dot" aria-hidden="true" />}
            {publicCta.label}
          </a>
        )}
      </div>
    </div>
  </header>

  <main class="org-page">
    <div class="org-page__inner">
      {justCreated && canAdmin && (
        <p class="org-banner">
          Empresa creada. Completa logo y textos en
          <a href={`/orgs/${org.slug}/settings`}>Ajustes</a>.
        </p>
      )}
      <div class="org-page__title-row" id="torneos">
        <h2 class="org-page__title">Torneos</h2>
        {org.tournaments.length > 0 && (
          <nav class="org-chips" aria-label="Filtrar torneos por estado">
            {ESTADOS.map(e => (
              <a
                href={chipHref(e.slug)}
                class:list={['org-chip', e.id === estadoActivo.id && 'is-active', e.id === 'LIVE' && 'is-live']}
                aria-current={e.id === estadoActivo.id ? 'page' : undefined}
              >
                {e.label}
                <span class="org-chip__n">{estadoCounts[e.id]}</span>
              </a>
            ))}
          </nav>
        )}
      </div>
      {visibleTournaments.length > 0 && (
        <div class="org-search">
          <SearchBar
            live
            placeholder="Filtrar torneos"
            ariaLabel="Filtrar torneos de esta empresa"
            value={q}
            id="org-q"
          />
        </div>
      )}
      {org.tournaments.length === 0 ? (
        <p class="org-empty">
          Esta empresa aún no tiene torneos publicados.
          {canManage && (
            <>
              {' '}
              <a href={`/orgs/${org.slug}/tournaments/new`}>Crea el primero</a>.
            </>
          )}
        </p>
      ) : visibleTournaments.length === 0 ? (
        <p class="org-empty">{emptyFilterMessage}</p>
      ) : (
        <>
          <div class="org-grid" id="org-grid">
            {visibleTournaments.map(t => (
              <OrgTournamentCard tournament={t} orgSlug={org.slug} canManage={canManage} />
            ))}
          </div>
          <p class="org-empty org-empty--live" hidden>Ningún torneo coincide.</p>
        </>
      )}
    </div>
  </main>
</Base>

<script>
  (function () {
    const inputEl = document.getElementById('org-q');
    const grid = document.getElementById('org-grid');
    if (!(inputEl instanceof HTMLInputElement) || !grid) return;
    const input = inputEl;

    const form = input.closest('form');
    const clearBtn = form?.querySelector<HTMLButtonElement>('.find__clear');
    const empty = document.querySelector<HTMLElement>('.org-empty--live');
    const cards = grid.querySelectorAll<HTMLElement>('.mini');
    const chips = document.querySelectorAll<HTMLAnchorElement>('.org-chips a');

    function fold(value: string): string {
      return value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();
    }

    function apply() {
      const needle = fold(input.value);
      let visible = 0;
      cards.forEach(card => {
        const hit = !needle
          || (card.dataset.nombre ?? '').includes(needle)
          || (card.dataset.deporte ?? '').includes(needle);
        card.hidden = !hit;
        if (hit) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      if (clearBtn) clearBtn.hidden = !input.value;

      const url = new URL(location.href);
      const raw = input.value.trim();
      if (raw) url.searchParams.set('q', raw);
      else url.searchParams.delete('q');
      history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);

      chips.forEach(chip => {
        const href = new URL(chip.getAttribute('href') || chip.href, location.origin);
        if (raw) href.searchParams.set('q', raw);
        else href.searchParams.delete('q');
        chip.href = `${href.pathname}${href.search}#torneos`;
      });
    }

    form?.addEventListener('submit', event => {
      event.preventDefault();
      apply();
    });
    input.addEventListener('input', apply);
    clearBtn?.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });
    apply();
  })();
</script>

<style>
.org-hero {
  padding: 44px 24px 32px;
  border-bottom: 1px solid var(--border);
}
.org-hero__inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 22px;
}
.org-hero__mark {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
  border: 1px solid var(--border);
}
.org-hero__mark img { width: 100%; height: 100%; object-fit: cover; }
.org-hero__text { flex: 1; min-width: 0; }
.org-hero__kicker {
  font-family: var(--font-display);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--text-muted);
  margin: 0 0 4px;
}
.org-hero__name {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 800;
  letter-spacing: 0.02em;
  margin: 0;
}
.org-hero__meta {
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
  margin: 6px 0 0;
}
.org-hero__desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin: 10px 0 0;
  max-width: 56ch;
  line-height: 1.5;
}
.org-hero__actions {
  margin-left: auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.org-hero__cta { flex-shrink: 0; }
.org-hero__cta--live {
  background: var(--live);
  color: #fff;
}
.org-hero__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 4px rgba(255,255,255,0.25);
}
.org-page { flex: 1; padding-bottom: 60px; }
.org-page__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px 24px 8px;
}
.org-page__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px 16px;
  flex-wrap: wrap;
  margin: 0 0 16px;
  scroll-margin-top: 80px;
}
.org-page__title {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  margin: 0;
}
.org-search {
  margin: 0 0 16px;
}
.org-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.org-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
  padding: 6px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
}
.org-chip:hover { color: var(--text-primary); border-color: var(--border-hover); }
.org-chip.is-active {
  color: #000;
  background: var(--accent);
  border-color: var(--accent);
}
.org-chip.is-live.is-active {
  color: #fff;
  background: var(--live);
  border-color: var(--live);
}
.org-chip__n {
  font-size: 0.65rem;
  font-weight: 800;
  opacity: 0.75;
}
.org-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 12px;
}
.org-empty {
  padding: 32px 8px;
  color: var(--text-muted);
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-align: center;
}
.org-empty a { color: var(--accent); }
.org-banner {
  margin: 0 0 16px;
  padding: 12px 14px;
  background: var(--bg-surface);
  border: 1px dashed var(--border);
  border-radius: var(--radius-md);
  font-size: 0.88rem;
  color: var(--text-secondary);
}
.org-banner a { color: var(--accent); }
@media (max-width: 600px) {
  .org-hero__inner { flex-direction: column; align-items: flex-start; }
  .org-hero__actions { margin-left: 0; }
}
</style>
