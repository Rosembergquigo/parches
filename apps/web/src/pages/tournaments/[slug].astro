---
/**
 * pages/tournaments/[slug].astro — página principal de un torneo.
 *
 * SSR puro. Renderiza con datos del torneo identificado por slug (o id,
 * ver lib/api.ts::getTournamentDetail). 404 si no existe.
 *
 * Estructura:
 *   TournamentHero        — header con nombre, deporte, estado. Usa la
 *                            paleta de brandColor por defecto, o la foto
 *                            de backgroundImageUrl (con overlay) si existe.
 *   TournamentLiveBar      — partidos en vivo ahora, o el próximo si no
 *                            hay ninguno en curso.
 *   TournamentFixtureStrip — primer componente principal: fixture con
 *                            estética de TournamentRow + dropdown para
 *                            saltar entre jornadas/rondas de playoffs.
 *                            Ocupa el ancho completo de la pantalla
 *                            (fuera del contenedor de 1280px).
 *   Tabs (click, no scroll-spy):
 *     Tabla        → StandingsTable (soporta grupos + clasificados)
 *     Equipos      → TeamsGrid
 *     Estadísticas → PlayerStatsTable (si hay datos — no forma parte del
 *                    pedido original, se conserva como tab adicional)
 *   Noticias/Foro → TournamentNewsFeed. Ya no es una pestaña: es su propia
 *                    sección, siempre visible debajo de Tabla/Equipos, al
 *                    75% del ancho de la página en pantallas grandes
 *                    (>= ~15", 100% en pantallas más chicas).
 */
import Base from '../../layouts/Base.astro';
import TournamentHero from '../../components/tournament/TournamentHero.astro';
import TournamentLiveBar from '../../components/tournament/TournamentLiveBar.astro';
import TournamentFixtureStrip from '../../components/tournament/TournamentFixtureStrip.astro';
import StandingsTable from '../../components/tournament/StandingsTable.astro';
import PlayerStatsTable from '../../components/tournament/PlayerStatsTable.astro';
import TeamsGrid from '../../components/tournament/TeamsGrid.astro';
import TournamentNewsFeed from '../../components/tournament/TournamentNewsFeed.astro';
import { getTournamentDetail } from '../../lib/api';
import { getTeamsForTournament, getAllStandingsRows, getTournamentNews } from '../../data/mock';

const { slug } = Astro.params;

const tournament = await getTournamentDetail(slug!, Astro.request);
if (!tournament) return Astro.redirect('/404');

const liveMatches = tournament.matches.filter(m => m.status === 'LIVE');

const nextMatch = tournament.matches
  .filter(m => m.status === 'SCHEDULED')
  .sort((a, b) => {
    if (!a.scheduledAt) return 1;
    if (!b.scheduledAt) return -1;
    return new Date(a.scheduledAt).getTime() - new Date(b.scheduledAt).getTime();
  })[0];

const teams = getTeamsForTournament(tournament);
const hasStandings = !!(tournament.standings?.length || tournament.standingsGroups?.length);

const showPlayoffs =
  tournament.policies?.playoffs === true &&
  (tournament.playoffGroups?.length ?? 0) > 0;

const newsPosts = getTournamentNews(tournament.id);
const hasPlayerStats = !!tournament.playerStats?.length;

// Tabs: Tabla | Equipos + Estadísticas como pestaña adicional (si hay datos).
// Noticias/Foro ya no vive aquí — ver sección aparte más abajo.
const tabs = [
  hasStandings   && { id: 'tabla', label: 'Tabla' },
  teams.length > 0 && { id: 'equipos', label: 'Equipos' },
  hasPlayerStats && { id: 'estadisticas', label: 'Estadísticas' },
].filter((t): t is { id: string; label: string } => !!t);
---

<Base
  title={`${tournament.name} | Chapi`}
  description={tournament.description ?? `Sigue ${tournament.name} en vivo en Chapi.`}
>

  <!-- Header: branding dinámico (paleta / foto de fondo) -->
  <TournamentHero tournament={tournament} />

  <main class="t-page">
    <div class="t-page__inner">
      <!-- Partidos en vivo, o el próximo si no hay ninguno -->
      <TournamentLiveBar
        liveMatches={liveMatches}
        nextMatch={nextMatch}
        sport={tournament.sport}
      />
    </div>

    <!-- Fixture / navegador de fechas — ancho completo de la pantalla -->
    <TournamentFixtureStrip
      groups={tournament.groups}
      playoffGroups={tournament.playoffGroups}
      showPlayoffs={showPlayoffs}
      sport={tournament.sport}
      brandColor={tournament.brandColor}
    />

    <div class="t-page__inner">
      <!-- Menú navegable de secciones (tabs con click, no scroll-spy) -->
      <nav class="t-tabs" id="tTabs" aria-label="Secciones del torneo">
        {tabs.map((tab, i) => (
          <button
            type="button"
            class:list={['t-tab', i === 0 && 't-tab--active']}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${tab.id}`}
            id={`tab-${tab.id}`}
            data-tab-target={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </nav>

      <!-- Tabla -->
      {hasStandings && (
        <div
          class:list={['t-panel', tabs[0]?.id === 'tabla' && 't-panel--active']}
          id="panel-tabla"
          role="tabpanel"
          aria-labelledby="tab-tabla"
          data-tab-panel="tabla"
          hidden={tabs[0]?.id !== 'tabla'}
        >
          <StandingsTable
            standings={tournament.standings}
            groups={tournament.standingsGroups}
            sport={tournament.sport}
            qualifyingSpots={tournament.qualifyingSpots ?? 4}
            brandColor={tournament.brandColor}
          />
        </div>
      )}

      <!-- Equipos -->
      {teams.length > 0 && (
        <div
          class:list={['t-panel', tabs[0]?.id === 'equipos' && 't-panel--active']}
          id="panel-equipos"
          role="tabpanel"
          aria-labelledby="tab-equipos"
          data-tab-panel="equipos"
          hidden={tabs[0]?.id !== 'equipos'}
        >
          <TeamsGrid
            teams={teams}
            standings={getAllStandingsRows(tournament)}
            brandColor={tournament.brandColor}
          />
        </div>
      )}

      <!-- Estadísticas (tab adicional, solo si hay datos) -->
      {hasPlayerStats && (
        <div
          class:list={['t-panel', tabs[0]?.id === 'estadisticas' && 't-panel--active']}
          id="panel-estadisticas"
          role="tabpanel"
          aria-labelledby="tab-estadisticas"
          data-tab-panel="estadisticas"
          hidden={tabs[0]?.id !== 'estadisticas'}
        >
          <PlayerStatsTable
            stats={tournament.playerStats ?? []}
            brandColor={tournament.brandColor}
          />
        </div>
      )}

      <!-- Noticias / Foro — ya no es una pestaña: sección propia, siempre
           visible debajo de Tabla/Equipos. 75% de ancho en pantallas
           grandes (>= ~15"), 100% en pantallas más chicas. -->
      <section class="t-news-section" aria-label="Noticias y comunicados del torneo">
        <TournamentNewsFeed
          posts={newsPosts}
          tournamentSlug={tournament.slug}
          brandColor={tournament.brandColor}
        />
      </section>

    </div><!-- /.t-page__inner -->
  </main>

</Base>

<style>
/* Page layout */
.t-page {
  flex: 1;
  padding-bottom: 60px;
}
.t-page__inner {
  max-width: 1280px;
  margin: 0 auto;
}

/* Section tabs — click to switch, sticky under the navbar */
.t-tabs {
  display: flex;
  gap: 4px;
  padding: 14px 24px;
  position: sticky;
  top: 50px;           /* below the 50px navbar */
  z-index: 10;
  background: rgba(10,12,15,0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
  margin: 8px 0 4px;
  overflow-x: auto;
  scrollbar-width: none;
}
.t-tabs::-webkit-scrollbar { display: none; }

.t-tab {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-secondary);
  padding: 8px 16px;
  border-radius: var(--radius-pill);
  background: transparent;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  transition: color var(--transition), background var(--transition);
}
.t-tab:hover { color: var(--text-primary); background: var(--bg-raised); }
.t-tab--active {
  color: var(--accent);
  background: var(--accent-dim);
}

/* Panels */
.t-panel {
  padding-top: 24px;
}
.t-panel[hidden] { display: none; }

/* Noticias / Foro — sección propia (no es tab), siempre debajo de
   Tabla/Equipos. En pantallas grandes (>= ~15", ~1440px) se angosta al
   75% del ancho de la página; en pantallas más chicas ocupa el 100%. */
.t-news-section {
  margin-top: 40px;
  padding-top: 32px;
  border-top: 1px solid var(--border);
}
@media (min-width: 1440px) {
  .t-news-section {
    max-width: 75%;
    margin-left: auto;
    margin-right: auto;
  }
}
</style>

<script>
  (function () {
    const nav = document.getElementById('tTabs');
    if (!nav) return;

    const tabs   = nav.querySelectorAll<HTMLButtonElement>('[data-tab-target]');
    const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tabTarget;

        tabs.forEach(t => {
          const active = t === tab;
          t.classList.toggle('t-tab--active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        panels.forEach(panel => {
          const active = panel.getAttribute('data-tab-panel') === target;
          panel.classList.toggle('t-panel--active', active);
          panel.hidden = !active;
        });
      });
    });
  })();
</script>
