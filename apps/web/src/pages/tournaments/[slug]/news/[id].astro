---
/**
 * Post público del foro / blog de un campeonato.
 */
import Base from '../../../../layouts/Base.astro';
import { getTournamentDetail, getTournamentPost } from '../../../../lib/api';
import { mediaUrl } from '../../../../lib/media';

const { slug, id } = Astro.params;
const tournament = await getTournamentDetail(slug!, Astro.request);
if (!tournament) return Astro.redirect('/404');

const post = await getTournamentPost(tournament.slug || tournament.id, id!, Astro.request);
if (!post) return Astro.redirect(`/tournaments/${tournament.slug}`);

const gallery = (post.imageUrls ?? []).filter(url => url !== post.coverImageUrl);
const published = new Date(post.publishedAt).toLocaleDateString('es-CO', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<Base
  title={`${post.title} | ${tournament.name}`}
  description={post.excerpt}
>
  <article class="post">
    <p class="post__crumb">
      <a href={`/tournaments/${tournament.slug}`}>{tournament.name}</a>
      <span aria-hidden="true"> / </span>
      <span>Foro</span>
    </p>

    <p class="post__meta">
      <span class="post__cat">{post.category}</span>
      {post.pinned && <span>Fijado</span>}
      <span>{post.author}</span>
      <span>{published}</span>
    </p>

    <h1 class="display-lg">{post.title}</h1>

    {post.coverImageUrl && (
      <img
        class="post__cover"
        src={mediaUrl(post.coverImageUrl)}
        alt=""
      />
    )}

    <div class="post__body">{post.body}</div>

    {gallery.length > 0 && (
      <div class="post__gallery" aria-label="Imágenes del post">
        {gallery.map(url => (
          <img src={mediaUrl(url)} alt="" />
        ))}
      </div>
    )}
  </article>
</Base>

<style>
.post {
  max-width: 760px;
  margin: 0 auto;
  padding: 28px 24px 80px;
}
.post__crumb {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-muted);
  margin: 0 0 16px;
}
.post__crumb a { color: var(--accent); }
.post__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  margin: 0 0 12px;
}
.post__cat { color: var(--accent); }
.post__cover {
  width: 100%;
  max-height: 420px;
  object-fit: cover;
  border-radius: var(--radius-lg);
  margin: 20px 0 24px;
  border: 1px solid var(--border);
}
.post__body {
  font-family: var(--font-body);
  font-size: 1.02rem;
  line-height: 1.65;
  color: var(--text-primary);
  white-space: pre-wrap;
  margin: 20px 0 28px;
}
.post__gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 10px;
}
.post__gallery img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
}
</style>
