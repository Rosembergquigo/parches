---
/**
 * pages/index.astro — Marketplace principal de Parches.
 *
 * Datos reales desde @parches/api (ver lib/api.ts + lib/adapters.ts).
 * El "viewer count" para ordenar el hero vive en streaming-data (Redis),
 * no en Postgres, así que por ahora el hero simplemente toma los primeros
 * partidos LIVE que encuentre — se puede refinar cuando streaming-data
 * esté conectado.
 */
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/hero/HeroCarousel.astro';
import LiveStrip from '../components/match/LiveStrip.astro';
import SportTabs from '../components/tournament/SportTabs.astro';
import TournamentRow from '../components/tournament/TournamentRow.astro';

import { getTournamentsWithMatches } from '../lib/api';
import type { Sport } from '../data/mock';

const tournaments = await getTournamentsWithMatches(Astro.request);

const liveMatches = tournaments.flatMap(t =>
  t.matches
    .filter(m => m.status === 'LIVE')
    .map(m => ({ ...m, _tournament: t.name, _sport: t.sport }))
) as any[];

const heroMatches = tournaments
  .flatMap(t =>
    t.matches
      .filter(m => m.status === 'LIVE')
      .map(m => ({ ...m, tournamentName: t.name, sport: t.sport, stage: t.stage }))
  )
  .slice(0, 3) as any[];

const activeSports: Sport[] = [...new Set(tournaments.map(t => t.sport))];

const liveCount = liveMatches.length;
const pageTitle = liveCount > 0
  ? `Chapi — ${liveCount} Partido${liveCount > 1 ? 's' : ''} en Vivo`
  : 'CHapi — Marketplace de Torneos';
const pageDesc = 'Sigue torneos y partidos en vivo de fútbol, baloncesto, tenis, voleibol y más deportes colombianos.';
---

<Base title={pageTitle} description={pageDesc}>

  {heroMatches.length > 0 && (
    <HeroCarousel matches={heroMatches} />
  )}

  {heroMatches.length === 0 && (
    <div class="hero-empty">
      <p class="display-md" style="color: var(--text-secondary);">
        No hay partidos en vivo ahora mismo
      </p>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 8px;">
        Revisa la programación de torneos abajo
      </p>
    </div>
  )}

  <main class="marketplace">

    {liveMatches.length > 0 && (
      <LiveStrip matches={liveMatches} />
    )}

    <section class="tournaments" aria-label="Torneos activos">
      <div class="tournaments__header">
        <h2 class="tournaments__title">Torneos activos</h2>
        <a href="/tournaments" class="tournaments__explore">Explorar todos →</a>
      </div>

      <SportTabs sports={activeSports} />

      {tournaments.map(tournament => (
        <TournamentRow tournament={tournament} />
      ))}

      {tournaments.length === 0 && (
        <div class="tournaments__empty">
          <p>No hay torneos activos en este momento.</p>
        </div>
      )}
    </section>

  </main>

</Base>

<style>
.hero-empty {
  height: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40px 24px;
  border-bottom: 1px solid var(--border);
}
.marketplace {
  flex: 1;
  padding-bottom: 60px;
}
.tournaments {
  padding-top: 28px;
}
.tournaments__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 24px;
  margin-bottom: 18px;
}
.tournaments__title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-primary);
}
.tournaments__explore {
  font-family: var(--font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--text-secondary);
  text-decoration: none;
  transition: color var(--transition);
}
.tournaments__explore:hover { color: var(--text-primary); }
.tournaments__empty {
  padding: 60px 24px;
  text-align: center;
  color: var(--text-muted);
  font-size: 0.9rem;
}
</style>