generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// USER & ROLES
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(VIEWER)
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones según rol
  refereedMatches Match[]        @relation("referee")
  playerProfile   PlayerProfile? // solo si role = PLAYER
  // Membresías en empresas. Organizar no cambia User.role — una persona
  // puede ser VIEWER/PLAYER y a la vez OWNER de una Organization.
  memberships OrganizationMember[]
}

enum UserRole {
  VIEWER
  PLAYER
  REFEREE
  ORGANIZER
  ADMIN
}

// ─────────────────────────────────────────────────────────────
// ORGANIZATION (empresa)
// Dueña de los torneos. Un User no "es" organizador por User.role:
// es miembro de una o más empresas (OWNER / ADMIN / EDITOR).
// ─────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  logoUrl     String?
  brandColor  String?
  description String?
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  tournaments Tournament[]
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(EDITOR)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────
// PLAYER PROFILE
// Separado de User para no contaminar la tabla de usuarios con
// campos que solo aplican a jugadores (posición, dorsal, etc.)
// ─────────────────────────────────────────────────────────────

model PlayerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Datos deportivos generales
  nationality  String?
  dateOfBirth  DateTime?
  height       Int? // cm
  weight       Int? // kg
  dominantHand String? // "right" | "left" — relevante para tenis

  // Inscripciones en equipos (muchos-a-muchos a través del torneo)
  enrollments PlayerEnrollment[]

  // Estadísticas acumuladas por partido
  matchStats PlayerMatchStat[]
}

// ─────────────────────────────────────────────────────────────
// PLAYER ENROLLMENT
// Un jugador puede estar en EQUIPO_A del TORNEO_1 y en
// EQUIPO_B del TORNEO_2. La combinación (player, team, tournament)
// es única — no puede estar dos veces en el mismo equipo del mismo torneo.
// ─────────────────────────────────────────────────────────────

model PlayerEnrollment {
  id              String        @id @default(uuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team          @relation(fields: [teamId], references: [id])
  tournamentId    String
  tournament      Tournament    @relation(fields: [tournamentId], references: [id])
  jerseyNumber    Int?
  position        String? // "delantero", "base", etc.
  isActive        Boolean       @default(true)
  joinedAt        DateTime      @default(now())

  // Stats del jugador en este torneo
  tournamentStats PlayerTournamentStat?

  @@unique([playerProfileId, teamId, tournamentId])
}

// ─────────────────────────────────────────────────────────────
// PLAYER STATS — dos niveles
//
// PlayerTournamentStat: totales acumulados en un torneo
// PlayerMatchStat:      stats de un partido específico
//
// Ambos usan Json para las stats deportivas concretas porque
// cada deporte tiene sus propias métricas. No ponemos columnas
// individuales (goles, aces, puntos...) porque eso requeriría
// una tabla diferente por deporte.
//
// Ejemplo payload fútbol:
//   { goals: 3, assists: 1, yellowCards: 0, minutesPlayed: 270 }
// Ejemplo payload basket:
//   { points: 45, rebounds: 12, assists: 8, steals: 3 }
// ─────────────────────────────────────────────────────────────

model PlayerTournamentStat {
  id            String           @id @default(uuid())
  enrollmentId  String           @unique
  enrollment    PlayerEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  matchesPlayed Int              @default(0)
  stats         Json // { goals, assists, ... } según deporte
  updatedAt     DateTime         @updatedAt
}

model PlayerMatchStat {
  id              String        @id @default(uuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  matchId         String
  match           Match         @relation(fields: [matchId], references: [id])
  teamId          String
  minutesPlayed   Int?
  stats           Json // { goals, assists, ... } según deporte
  createdAt       DateTime      @default(now())

  @@unique([playerProfileId, matchId])
}

// ─────────────────────────────────────────────────────────────
// TOURNAMENT
// ─────────────────────────────────────────────────────────────

model Tournament {
  id          String           @id @default(uuid())
  // Identificador amigable para URLs (/tournaments/[slug]). Generado a partir
  // de `name` al crear el torneo. Nullable por compatibilidad con filas
  // creadas antes de este campo — el código de la app siempre lo genera.
  slug        String?          @unique
  name        String
  sport       String
  status      TournamentStatus @default(UPCOMING)
  startDate   DateTime
  endDate     DateTime
  brandColor  String? // hex del color de marca — paleta por defecto del header
  logoUrl     String?
  // Imagen de fondo del header (subida por el organizador). Si está presente,
  // el header la muestra con un overlay oscuro en vez del gradiente de brandColor.
  backgroundImageUrl String?
  description String?
  createdAt   DateTime         @default(now())

  // Política de playoffs: cuando hasPlayoffs=true y hay >1 grupo,
  // GET /tournaments/:id/standings arma la tabla compilada de
  // clasificados (top qualifyingSpots de cada grupo) y los cruces
  // sugeridos. POST /tournaments/:id/crossmatches/generate los
  // materializa como Match reales (stage="Cruces").
  hasPlayoffs     Boolean @default(false)
  qualifyingSpots Int? // cuántos equipos clasifican por grupo

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  teams       Team[]
  groups      Group[]
  matches     Match[]
  enrollments PlayerEnrollment[]

  @@index([organizationId])
}

enum TournamentStatus {
  UPCOMING
  LIVE
  FINISHED
}

// ─────────────────────────────────────────────────────────────
// GROUP
// Fase de grupos para deportes/torneos con muchos equipos
// (ej. "Grupo A", "Zona Norte"). Opcional: un torneo sin fase
// de grupos simplemente no tiene Group rows y sus Team.groupId
// quedan null.
// ─────────────────────────────────────────────────────────────

model Group {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  label        String // "Grupo A"
  order        Int        @default(0)

  teams Team[]

  @@unique([tournamentId, label])
}

// ─────────────────────────────────────────────────────────────
// TEAM
// ─────────────────────────────────────────────────────────────

model Team {
  id           String     @id @default(uuid())
  name         String
  shortName    String // 3 letras para el logo placeholder
  logoUrl      String?
  color        String? // hex de marca del equipo
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  groupId      String?
  group        Group?     @relation(fields: [groupId], references: [id])

  homeMatches Match[]            @relation("homeTeam")
  awayMatches Match[]            @relation("awayTeam")
  enrollments PlayerEnrollment[]
}

// ─────────────────────────────────────────────────────────────
// MATCH
// ─────────────────────────────────────────────────────────────

model Match {
  id           String      @id @default(uuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])
  homeTeamId   String
  homeTeam     Team        @relation("homeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String
  awayTeam     Team        @relation("awayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int         @default(0)
  awayScore    Int         @default(0)
  status       MatchStatus @default(SCHEDULED)
  clock        String?
  period       String?
  // Agrupa el partido dentro del fixture/bracket: "Jornada 18",
  // "Cruces" (generado desde standings), "Semifinal", "Final"...
  // Null = fase de grupos / todos-contra-todos sin ronda nombrada.
  stage        String?
  venue        String?
  streamKey    String?     @unique
  hlsUrl       String?
  // Estadísticas comparativas del partido (remates, posesión, aces...).
  // Forma libre por deporte: MatchStatRow[] — { label, home, away, isPercentage?, higherIsBetter? }.
  stats        Json?
  refereeId    String?
  referee      User?       @relation("referee", fields: [refereeId], references: [id])
  startedAt    DateTime?
  scheduledAt  DateTime?
  createdAt    DateTime    @default(now())

  events      MatchEvent[]
  playerStats PlayerMatchStat[]
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
}

// ─────────────────────────────────────────────────────────────
// MATCH EVENT
// ─────────────────────────────────────────────────────────────

model MatchEvent {
  id          String   @id @default(uuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id])
  type        String
  clock       String
  teamId      String?
  playerId    String? // PlayerProfile.id
  description String?
  payload     Json?
  refereeId   String? // quién registró el evento
  createdAt   DateTime @default(now())
}
